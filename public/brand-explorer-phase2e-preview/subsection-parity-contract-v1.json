    "APPLICABLE_POPULATED",
    "slotKey",
    "phase2",
    "diligence framing only",
    "do not invent",
    "Internal Preview",
    "\\[insight\\.similar\\]",
    "\\[standards\\.similar\\]",
    "economics\\.[a-z0-9_.]+\\s*:",
    "Owner diligence note"
