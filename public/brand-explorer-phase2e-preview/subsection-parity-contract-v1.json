        { "id": "overview.proof", "section": "Proof Points", "label": "Proof Points", "slotPatterns": ["^overview\\.proof\\.\\d+$"], "minItems": 4, "forbidGenericTitles": ["Proof 1", "Proof 2", "Proof 3", "Proof 4", "Proof 5", "Proof 6"] },
        { "id": "overview.featured", "section": "Featured Application", "label": "Featured Application / Conversion Example", "slotPatterns": ["^overview\\.featured"] },
