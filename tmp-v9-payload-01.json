"<style id=\"dc-v9-css-1\">\n:root{--bg:#080F25;--bg2:#0D1530;--bg3:#111B3A;--bg4:#0A1228;--purple:#6C72FF;--purple-hover:#5A5FE6;--pl:#8B90FF;--pd:rgba(108,114,255,.12);--gold:#D78E2C;--cream:#FAF3E1;--white:#fff;--mu:rgba(255,255,255,.38);--se:rgba(255,255,255,.62);--bo:rgba(255,255,255,.07);--bp:rgba(108,114,255,.28);--font:'Plus Jakarta Sans',sans-serif;--serif:'Lora',serif;--ease:cubic-bezier(.22,1,.36,1)}\r\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\r\nhtml{scroll-behavior:smooth}\r\n[id]{scroll-margin-top:80px}\r\nbody{font-family:var(--font);background:var(--bg);color:var(--white);overflow-x:hidden;-webkit-font-smoothing:antialiased}\r\n.dg{position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(45deg,rgba(108,114,255,.025) 1px,transparent 1px),linear-gradient(-45deg,rgba(108,114,255,.025) 1px,transparent 1px);background-size:56px 56px}\r\nsvg.icon{color:var(--pl);flex-shrink:0}\r\nnav{position:fixed;top:0;left:0;right:0;z-index:200;height:66px;padding:0 48px;display:flex;align-items:center;justify-content:space-between;background:rgba(8,15,37,.88);backdrop-filter:blur(20px);border-bottom:1px solid var(--bo);transition:background .4s}\r\nnav.sc{background:rgba(8,15,37,.98)}\r\n.logo{text-decoration:none;display:flex;align-items:center;line-height:0}\r\n.logo img{height:28px;width:auto;display:block}\r\n.nl{display:flex;gap:28px;list-style:none}\r\n.nl a{font-size:14px;font-weight:500;color:var(--se);text-decoration:none;transition:color .2s}\r\n.nl a:hover{color:var(--white)}\r\n.nmenu{display:none;background:none;border:none;cursor:pointer;padding:8px;color:var(--white)}\r\n.nmenu svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2}\r\n.mnav{position:fixed;inset:0;z-index:190;background:rgba(8,15,37,.96);backdrop-filter:blur(16px);padding:88px 28px 32px;opacity:0;pointer-events:none;transition:opacity .3s var(--ease)}\r\n.mnav.open{opacity:1;pointer-events:auto}\r\n.mnav ul{list-style:none;display:flex;flex-direction:column;gap:4px}\r\n.mnav a{display:block;font-size:18px;font-weight:600;color:var(--se);text-decoration:none;padding:14px 0;border-bottom:1px solid var(--bo);transition:color .2s}\r\n.mnav a:hover{color:var(--white)}\r\n.mnav-cta{margin-top:24px;display:flex;flex-direction:column;gap:10px}\r\n.nr{display:flex;gap:10px;align-items:center}\r\n.nbg{font-size:14px;font-weight:500;color:var(--se);background:none;border:none;cursor:pointer;padding:8px 14px;border-radius:6px;transition:color .2s,background .2s;text-decoration:none}\r\n.nbg:hover{color:var(--white);background:rgba(255,255,255,.05)}\r\n.nbn{font-size:14px;font-weight:700;color:var(--white);background:var(--purple);border:none;cursor:pointer;padding:9px 20px;border-radius:6px;text-decoration:none;transition:background .2s,transform .15s,box-shadow .2s}\r\n.nbn:hover{background:var(--purple-hover);transform:translateY(-1px);box-shadow:0 6px 20px rgba(108,114,255,.28)}\r\n#hero{position:relative;min-height:88vh;display:flex;align-items:center;justify-content:center;padding:140px 48px 100px;overflow:hidden;text-align:center;isolation:isolate;--hero-split:50%;--hero-split-y:52%}\r\n.hero-mesh{position:absolute;inset:0;z-index:0;width:100%;height:100%;pointer-events:none;display:block;-webkit-mask-image:linear-gradient(90deg,#fff 0%,#fff calc(var(--hero-split) - 10%),rgba(255,255,255,.4) calc(var(--hero-split) - 4%),transparent var(--hero-split));mask-image:linear-gradient(90deg,#fff 0%,#fff calc(var(--hero-split) - 10%),rgba(255,255,255,.4) calc(var(--hero-split) - 4%),transparent var(--hero-split))}\r\n.hero-readability{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,rgba(8,15,37,.72) 0%,rgba(8,15,37,.38) calc(var(--hero-split) - 14%),var(--bg) var(--hero-split),var(--bg) 100%)}\r\n.bg-blob{position:absolute;pointer-events:none;z-index:0;user-select:none;width:min(780px,92vw);height:auto;opacity:.92}\r\n#cta .bg-blob{top:50%;left:50%;transform:translate(-50%,-50%);width:min(640px,88vw);opacity:.75}\r\n.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:1fr;align-items:center;max-width:min(900px,94vw);margin:0 auto;width:100%;text-align:center;justify-items:center}\r\n#hero.hero--center .hero-mesh{-webkit-mask-image:linear-gradient(90deg,#fff 0%,#fff 26%,rgba(255,255,255,.4) 36%,transparent 46%);mask-image:linear-gradient(90deg,#fff 0%,#fff 26%,rgba(255,255,255,.4) 36%,transparent 46%)}\r\n#hero.hero--center .hero-readability{background:linear-gradient(90deg,rgba(8,15,37,.5) 0%,rgba(8,15,37,.24) 28%,var(--bg) 46%,var(--bg) 100%)}\r\n@media(max-width:960px){#hero.hero--center .hero-mesh{-webkit-mask-image:linear-gradient(180deg,#fff 0%,#fff 22%,rgba(255,255,255,.35) 32%,transparent 42%);mask-image:linear-gradient(180deg,#fff 0%,#fff 22%,rgba(255,255,255,.35) 32%,transparent 42%)}#hero.hero--center .hero-readability{background:linear-gradient(180deg,rgba(8,15,37,.55) 0%,rgba(8,15,37,.28) 26%,var(--bg) 42%,var(--bg) 100%)}}\r\n.hleft{display:flex;flex-direction:column;align-items:center;text-align:center;min-width:0;max-width:100%;width:100%;overflow:visible}\r\n.hero-overview-wrap{background:var(--bg);border-top:1px solid var(--bo);padding:0 clamp(20px,4vw,48px)}\r\n.hero-overview-wrap[hidden]{display:none!important}\r\n.hero-overview-wrap.is-open{padding:clamp(28px,4vw,40px) clamp(20px,4vw,48px) clamp(40px,5vw,64px)}\r\n.hero-overview-in{max-width:min(720px,94vw);margin:0 auto}\r\n.hero-overview-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}\r\n.hero-overview-ey{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--pl);margin:0}\r\n.hero-overview-close{font-size:13px;font-weight:600;color:var(--se);background:rgba(255,255,255,.04);border:1px solid var(--bo);border-radius:6px;cursor:pointer;padding:7px 12px;font-family:inherit;transition:border-color .2s,color .2s,background .2s}\r\n.hero-overview-close:hover{color:var(--white);border-color:var(--bp);background:var(--pd)}\r\n.hero-overview-frame{border-radius:12px;overflow:hidden;border:1px solid rgba(108,114,255,.32);box-shadow:0 24px 56px rgba(0,0,0,.45),0 0 0 1px rgba(108,114,255,.1);background:#000}\r\n.hero-overview-frame video{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;background:#000;vertical-align:top}\r\n.hbadge{display:inline-flex;align-items:center;gap:8px;background:rgba(108,114,255,.1);border:1px solid var(--bp);padding:6px 16px;border-radius:100px;font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--pl);margin-bottom:32px;animation:fu .7s both}\r\n.puls{width:6px;height:6px;border-radius:50%;background:var(--gold);animation:pulse 3s infinite}\r\n@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}\r\n@keyframes fu{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}\r\n.h1wrap{margin:0 auto;animation:fu .7s .1s both;width:auto;max-width:100%;overflow:hidden;display:inline-flex;flex-wrap:nowrap;align-items:center;justify-content:center;gap:.32em;isolation:isolate;--hr-lh:clamp(32px,4vw,56px);--hr-slots:5;--hr-center:2}\r\n.hstatic{position:relative;z-index:2;font-weight:800;font-size:clamp(26px,3.6vw,48px);line-height:1.08;letter-spacing:-.035em;color:var(--white);display:inline-block;margin:0;white-space:nowrap;flex-shrink:0;align-self:center}\r\n.hrwrap{display:inline-block;vertical-align:middle;height:calc(var(--hr-lh)*var(--hr-slots));width:var(--hr-w,auto);min-width:0;overflow:hidden;isolation:isolate;contain:strict;transform:translateZ(0);animation:fu .7s .12s both;flex-shrink:0;position:relative;z-index:1;-webkit-mask-image:linear-gradient(180deg,transparent 0%,#000 12%,#000 88%,transparent 100%);mask-image:linear-gradient(180deg,transparent 0%,#000 12%,#000 88%,transparent 100%)}\r\n.hrinner{display:flex;flex-direction:column;transition:transform .65s cubic-bezier(.77,0,.18,1);will-change:transform;backface-visibility:hidden}\r\n.hrword{display:flex;align-items:center;font-family:var(--serif);font-style:italic;font-weight:400;font-size:clamp(26px,3.6vw,48px);line-height:1.08;height:var(--hr-lh);color:var(--pl);white-space:nowrap;opacity:.08;transition:opacity .45s ease,color .45s ease,font-weight .45s ease;padding:0;margin:0;text-align:left}\r\n.hrword.near{opacity:.28}\r\n.hrword.far{opacity:.14}\r\n.hrword.on{font-family:var(--font);font-style:normal;font-weight:800;letter-spacing:-.035em;line-height:1.08;color:var(--gold);opacity:1}\r\n.hsub{font-size:16.5px;color:var(--se);line-height:1.74;margin:31px auto 36px;max-width:620px;animation:fu .7s .22s both}\r\n.hctas{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:0;animation:fu .7s .32s both;justify-content:center}\r\n.bp2{font-size:15px;font-weight:700;color:var(--white);background:var(--purple);border:none;cursor:pointer;padding:13px 26px;border-radius:8px;text-decoration:none;transition:background .2s,transform .15s,box-shadow .2s}\r\n.bp2:hover{background:var(--purple-hover);transform:translateY(-2px);box-shadow:0 8px 28px rgba(108,114,255,.3)}\r\n.bs2{font-size:15px;font-weight:600;color:var(--white);background:transparent;border:1.5px solid var(--bp);cursor:pointer;padding:13px 26px;border-radius:8px;text-decoration:none;transition:border-color .2s,background .2s;font-family:inherit}\r\n.bs2:hover{border-color:var(--purple);background:var(--pd)}\r\n.htrust{font-size:12.5px;color:var(--mu);letter-spacing:.04em;animation:fu .7s .42s both;line-height:1.6;max-width:520px;margin:0}\r\n.htrust em{font-style:normal;color:var(--se)}\r\n.owners-aside{display:flex;flex-direction:column;gap:clamp(28px,3vw,40px)}\r\n.sf{border-radius:10px;overflow:hidden;border:1px solid rgba(108,114,255,.32);box-shadow:0 32px 72px rgba(0,0,0,.55),0 0 0 1px rgba(108,114,255,.1);animation:fu .9s .35s both}\r\n.sfc{background:#111B38;padding:10px 14px;display:flex;align-items:center;gap:7px;border-bottom:1px solid rgba(108,114,255,.18)}\r\n.sfd{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.15)}\r\n.sfu{font-size:11px;color:rgba(255,255,255,.28);margin-left:8px;font-family:monospace}\r\n\n</style>"