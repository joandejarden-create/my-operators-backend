{
  "version": "BE_SUBSECTION_PARITY_CONTRACT_V1",
  "phase": "2G",
  "hierarchy": ["brand", "tab", "section", "subsection", "contentItem"],
  "comparisonDefault": "paired_subsection_document",
  "forbidDualFullPageScrollAsDefault": true,
  "customerFacingForbiddenPatterns": [
    "Evidence-grounded reconstruction",
    "Focus this card on",
    "RESEARCH_REQUIRED",
    "APPLICABLE_POPULATED",
    "slotKey",
    "phase2",
    "diligence framing only",
    "do not invent",
    "Internal Preview",
    "\\[insight\\.similar\\]",
    "\\[standards\\.similar\\]",
    "economics\\.[a-z0-9_.]+\\s*:",
    "Owner diligence note"
  ],
  "tabs": [
    {
      "tabId": "atelier-overview",
      "tabName": "Overview",
      "subsections": [
        { "id": "overview.snapshot", "section": "Brand Snapshot", "label": "Brand Snapshot", "slotPatterns": ["^snapshot\\.", "^identity\\.", "^overview\\.(typical_use_case|development_model|relative_positioning)$"] },
        { "id": "overview.positioning", "section": "Brand Positioning", "label": "Brand Positioning", "slotPatterns": ["^positioning\\."] },
        { "id": "overview.scenarios", "section": "Where This Brand Creates the Most Value", "label": "Where This Brand Creates the Most Value", "slotPatterns": ["^overview\\.scenario\\.\\d+$"], "minItems": 3, "requireImage": true, "componentType": "scenario_card" },
        { "id": "overview.why_value", "section": "Why Value Is Strongest in These Scenarios", "label": "Why Value Is Strongest in These Scenarios", "slotPatterns": ["^overview\\.why_value$"], "minInsights": 5, "format": "Bold Title Case Insight + explanatory sentence" },
        { "id": "overview.differentiators", "section": "Key Differentiators", "label": "Key Differentiators", "slotPatterns": ["^overview\\.differentiators\\.(identity|commercial)$"], "categories": ["Experience & Identity", "Commercial & Distribution"], "exactBulletsPerCategory": 4 },
        { "id": "overview.best_at", "section": "What This Brand Is Best At", "label": "What This Brand Is Best At", "slotPatterns": ["^overview\\.bestAt\\.\\d+$"], "minItems": 3 },
        { "id": "overview.proof", "section": "Proof Points", "label": "Proof Points", "slotPatterns": ["^overview\\.proof\\.\\d+$"], "minItems": 4, "forbidGenericTitles": ["Proof 1", "Proof 2", "Proof 3", "Proof 4", "Proof 5", "Proof 6"] },
        { "id": "overview.featured", "section": "Featured Application", "label": "Featured Application / Conversion Example", "slotPatterns": ["^overview\\.featured"] },
        { "id": "overview.portfolio", "section": "Portfolio Context", "label": "Portfolio Context", "slotPatterns": ["^overview\\.portfolio_context$"] }
      ]
    },
    {
      "tabId": "atelier-value-owners",
      "tabName": "Value to Owners",
      "subsections": [
        {
          "id": "value.really_buying",
          "section": "What the Owner Is Really Buying",
          "label": "What the Owner Is Really Buying",
          "slotPatterns": ["^valueOwners\\.overview", "^owner\\.outcomes$", "^overview\\.owner_experience$"],
          "minItems": 2,
          "requiredPropositions": ["What the Guest Receives", "What the Hotel Owner Receives"],
          "forbidReduceTo": ["Owner outcomes"],
          "critical": true
        },
        { "id": "value.scenarios", "section": "Value Creation Scenarios", "label": "Value Creation Scenarios", "slotPatterns": ["^valueOwners\\.scenario\\.\\d+$"], "minItems": 4 },
        { "id": "value.lifecycle", "section": "Support Across the Lifecycle", "label": "Support Across the Lifecycle", "slotPatterns": ["^valueOwners\\.lifecycle\\.\\d+$"], "minItems": 6, "exactItems": 6, "forbidInventedSeventh": true },
        { "id": "value.watchouts", "section": "Key Watchouts", "label": "Key Watchouts", "slotPatterns": ["^valueOwners\\.watchouts$"] }
      ]
    },
    {
      "tabId": "atelier-ops",
      "tabName": "Operating Model",
      "subsections": [
        { "id": "ops.model", "section": "Operating Model", "label": "Operating Model", "slotPatterns": ["^operations\\.model"] },
        { "id": "ops.standards", "section": "Standards Philosophy", "label": "Standards Philosophy", "slotPatterns": ["^operations\\.standards_philosophy$"] },
        { "id": "ops.flexibility", "section": "Flexibility Indicators", "label": "Flexibility Indicators", "slotPatterns": ["^operations\\.flexibility\\."] },
        { "id": "ops.operator", "section": "Third-Party Operator Compatibility", "label": "Third-Party Operator Compatibility", "slotPatterns": ["^operations\\.operator_compat\\."] },
        { "id": "ops.compliance", "section": "Compliance & Oversight", "label": "Compliance & Oversight", "slotPatterns": ["^operations\\.compliance\\."] }
      ]
    },
    {
      "tabId": "atelier-standards-owner",
      "tabName": "Owner Considerations",
      "subsections": [
        { "id": "standards.requirements", "section": "Owner Considerations", "label": "Owner Considerations / Requirements", "slotPatterns": ["^standards\\."] }
      ]
    },
    {
      "tabId": "atelier-commercial",
      "tabName": "Commercial Engine",
      "subsections": [
        { "id": "commercial.intro", "section": "Commercial Engine", "label": "Commercial Intro & Perception", "slotPatterns": ["^commercial\\.(intro|perception|differentiator)$"] },
        { "id": "commercial.demand", "section": "Demand Scenario View", "label": "Demand Scenario View", "slotPatterns": ["^commercial\\.demand"], "minItems": 6 },
        { "id": "commercial.levers", "section": "Commercial Levers", "label": "Commercial Levers", "slotPatterns": ["^commercial\\.lever\\."] },
        { "id": "commercial.kpis", "section": "Commercial KPIs", "label": "Commercial KPIs", "slotPatterns": ["^commercial\\.kpi\\."] }
      ]
    },
    {
      "tabId": "atelier-economics",
      "tabName": "Economics & Obligations",
      "subsections": [
        { "id": "economics.fees", "section": "Fee Structure", "label": "Fees & Fee Stack", "slotPatterns": ["^economics\\.fee"] },
        { "id": "economics.cash", "section": "Cash & Capital", "label": "Cash & Capital Rhythm", "slotPatterns": ["^economics\\.cash\\.", "^economics\\.lifecycle\\."] },
        { "id": "economics.negotiable", "section": "Negotiable Items", "label": "Negotiable Items", "slotPatterns": ["^economics\\.(negotiab|rarely_negotiable|negotiable)"] },
        { "id": "economics.opening", "section": "Opening & Conversion Path", "label": "Opening & Conversion Path", "slotPatterns": ["^economics\\.opening"] },
        { "id": "economics.risks", "section": "Risks & Legal", "label": "Risks, Legal & Exit", "slotPatterns": ["^economics\\.(risk|legal|performance|support|diligence|checklist|model|intro|incentives|term)"] },
        { "id": "economics.kpis", "section": "Economics KPIs", "label": "Economics KPI Cards", "slotPatterns": ["^economics\\.kpi\\."] }
      ]
    },
    {
      "tabId": "atelier-loyalty",
      "tabName": "Loyalty Program",
      "subsections": [
        { "id": "loyalty.program", "section": "Loyalty Architecture", "label": "Loyalty Architecture", "slotPatterns": ["^loyalty\\."] }
      ]
    },
    {
      "tabId": "atelier-footprint",
      "tabName": "Footprint & Growth",
      "subsections": [
        { "id": "footprint.geo", "section": "Geographic Footprint", "label": "Geographic Footprint", "slotPatterns": ["^footprint\\.(geo|primary|region|editorial)"] },
        { "id": "footprint.growth", "section": "Growth Priorities", "label": "Growth Priorities", "slotPatterns": ["^footprint\\.growth", "^metric\\."] },
        { "id": "footprint.momentum", "section": "Recent Momentum & Portfolio Mix", "label": "Recent Momentum & Portfolio Mix", "slotPatterns": ["^footprint\\.(momentum|openings|portfolio_mix)"] }
      ]
    },
    {
      "tabId": "atelier-materials",
      "tabName": "Brand Materials",
      "subsections": [
        { "id": "materials.gallery", "section": "Gallery", "label": "Image Gallery", "slotPatterns": ["^materials\\.gallery\\.\\d+$"], "minItems": 6, "requireImage": true },
        { "id": "materials.files", "section": "Supporting Materials", "label": "Files & Case Studies", "slotPatterns": ["^materials\\.(file|caseStudy|documents)"] }
      ]
    },
    {
      "tabId": "atelier-insight",
      "tabName": "Dealality Insight",
      "subsections": [
        { "id": "insight.similar", "section": "Similar Brands", "label": "Similar Brands", "slotPatterns": ["^insight\\.similar"] }
      ]
    }
  ]
}
