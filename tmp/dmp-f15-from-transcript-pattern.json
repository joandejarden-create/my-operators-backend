roke-width=\"5.8\"\r\n                  stroke-linecap=\"round\"\r\n                  stroke-linejoin=\"round\"\r\n                />\r\n                <circle cx=\"41.5\" cy=\"62.5\" r=\"4.4\" fill=\"currentColor\" />\r\n              </svg>\r\n            </div>\r\n          </div>\r\n          <div class=\"dmp-decision-mark\" aria-hidden=\"true\">\r\n            <svg viewBox=\"0 0 40 40\" fill=\"none\">\r\n              <circle cx=\"20\" cy=\"20\" r=\"15\" stroke=\"#fdb52a\" stroke-width=\"1.6\"/>\r\n              <path d=\"M20 10.5l2.1 4.3 4.7.7-3.4 3.3.8 4.7L20 21.2l-4.2 2.3.8-4.7-3.4-3.3 4.7-.7L20 10.5z\" stroke=\"#fdb52a\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/>\r\n            </svg>\r\n          </div>\r\n          <ol class=\"dmp-questions\">\r\n            <li class=\"dmp-q\">\r\n              <span class=\"dmp-q-num\" aria-hidden=\"true\">1</span>\r\n              <span class=\"dmp-q-text\">Was the strongest path explored?</span>\r\n            </li>\r\n            <li class=\"dmp-q\">\r\n              <span class=\"dmp-q-num\" aria-hidden=\"true\">2</span>\r\n              <span class=\"dmp-q-text\">Were the economics truly comparable?</span>\r\n            </li>\r\n            <li class=\"dmp-q\">\r\n              <span class=\"dmp-q-num\" aria-hidden=\"true\">3</span>\r\n              <span class=\"dmp-q-text\">What value was never uncovered?</span>\r\n            </li>\r\n          </ol>\r\n        </article>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"dmp-problems\">\r\n      <article class=\"dmp-problem\">\r\n        <div class=\"dmp-problem-icon\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n            <path d=\"M8 20c8-14 16 14 24 0\" stroke=\"#9B8AFB\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\r\n            <path d=\"M8 24c8 12 16-12 24 0\" stroke=\"#9B8AFB\" stroke-width=\"1.4\" opacity=\".55\" stroke-linecap=\"round\"/>\r\n            <path d=\"M12 12c6 8 10-8 16 4\" stroke=\"#9B8AFB\" stroke-width=\"1.3\" opacity=\".7\" stroke-linecap=\"round\"/>\r\n          </svg>\r\n        </div>\r\n        <div class=\"dmp-problem-text\">\r\n          <h3 class=\"dmp-problem-h\">Manual. Fragmented. Costly.</h3>\r\n          <p class=\"dmp-problem-p\">Critical information is scattered. Context is lost, and the full picture stays limited.</p>\r\n        </div>\r\n      </article>\r\n      <article class=\"dmp-problem\">\r\n        <div class=\"dmp-problem-icon\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n            <!-- Too few options evaluated: one solid choice, two faded / incomplete -->\r\n            <rect x=\"7\" y=\"8\" width=\"14\" height=\"8\" rx=\"2\" stroke=\"#9B8AFB\" stroke-width=\"1.55\"/>\r\n            <circle cx=\"11.2\" cy=\"12\" r=\"1.55\" fill=\"#9B8AFB\"/>\r\n            <path d=\"M15 12h3.5\" stroke=\"#9B8AFB\" stroke-width=\"1.35\" stroke-linecap=\"round\"/>\r\n            <rect x=\"7\" y=\"18.5\" width=\"14\" height=\"8\" rx=\"2\" stroke=\"#9B8AFB\" stroke-width=\"1.45\" opacity=\".45\" stroke-dasharray=\"2.4 2.2\"/>\r\n            <circle cx=\"11.2\" cy=\"22.5\" r=\"1.45\" stroke=\"#9B8AFB\" stroke-width=\"1.25\" opacity=\".5\"/>\r\n            <rect x=\"7\" y=\"29\" width=\"14\" height=\"5.5\" rx=\"1.8\" stroke=\"#9B8AFB\" stroke-width=\"1.3\" opacity=\".28\" stroke-dasharray=\"2 2\"/>\r\n            <!-- Hard to compare: unequal bars -->\r\n            <path d=\"M27 30V18.5M31.5 30V13M36 30V22\" stroke=\"#9B8AFB\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\r\n            <path d=\"M25.5 31.5h12\" stroke=\"#9B8AFB\" stroke-width=\"1.35\" stroke-linecap=\"round\" opacity=\".7\"/>\r\n          </svg>\r\n        </div>\r\n        <div class=\"dmp-problem-text\">\r\n          <h3 class=\"dmp-problem-h\">Too Few Options. Hard to Compare.</h3>\r\n          <p class=\"dmp-problem-p\">Fewer paths get evaluated—and those that return are hard to compare equally.</p>\r\n        </div>\r\n      </article>\r\n      <article class=\"dmp-problem\">\r\n        <div class=\"dmp-problem-icon\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n            <!-- Value left on the table: tabletop + stacked value, path walks past -->\r\n            <path d=\"M8 24h24\" stroke=\"#9B8AFB\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\r\n            <path d=\"M11 24v6M29 24v6\" stroke=\"#9B8AFB\" stroke-width=\"1.45\" stroke-linecap=\"round\"/>\r\n            <path d=\"M9 30h22\" stroke=\"#9B8AFB\" stroke-width=\"1.35\" stroke-linecap=\"round\" opacity=\".55\"/>\r\n            <!-- Value stack left on the table -->\r\n            <ellipse cx=\"16\" cy=\"20.2\" rx=\"4.2\" ry=\"1.6\" stroke=\"#9B8AFB\" stroke-width=\"1.4\"/>\r\n            <path d=\"M11.8 20.2v-3.2c0-.9 1.9-1.6 4.2-1.6s4.2.7 4.2 1.6v3.2\" stroke=\"#9B8AFB\" stroke-width=\"1.35\"/>\r\n            <ellipse cx=\"16\" cy=\"17\" rx=\"4.2\" ry=\"1.5\" stroke=\"#9B8AFB\" stroke-width=\"1.3\" opacity=\".75\"/>\r\n            <path d=\"M11.8 17v-2.8c0-.85 1.9-1.5 4.2-1.5s4.2.65 4.2 1.5V17\" stroke=\"#9B8AFB\" stroke-width=\"1.25\" opacity=\".75\"/>\r\n            <ellipse cx=\"16\" cy=\"14.2\" rx=\"4.2\" ry=\"1.4\" stroke=\"#9B8AFB\" stroke-width=\"1.25\"/>\r\n            <!-- Decision path bypasses the value -->\r\n            <path d=\"M24 11c4 1.5 7 4 9 8.5\" stroke=\"#9B8AFB\" stroke-width=\"1.45\" stroke-linecap=\"round\" opacity=\".7\"/>\r\n            <path d=\"M30.2 17.2l2.8 2.3 2.2-3.2\" stroke=\"#9B8AFB\" stroke-width=\"1.35\" stroke-linecap=\"round\" stroke-linejoin=\"round\" opacity=\".7\"/>\r\n          </svg>\r\n        </div>\r\n        <div class=\"dmp-problem-text\">\r\n          <h3 class=\"dmp-problem-h\">Value Can Be Left on the Table.</h3>\r\n          <p class=\"dmp-problem-p\">Incredible alternatives may never have been identified or explored.</p>\r\n        </div>\r\n      </article>\r\n    </div>\r\n\r\n    <div class=\"dmp-close\">\r\n      <div class=\"dmp-close-copy\">\r\n        <h3 class=\"dmp-close-h\">A Decision Was Reached, But Did the Process Leave Value Unexplored?</h3>\r\n        <p class=\"dmp-close-p\">You can reach a decision and still leave the highest-value path undiscovered.</p>\r\n      </div>\r\n      <div class=\"dmp-close-actions\">\r\n        <button type=\"button\" class=\"dmp-cta\" data-dmp-cta=\"demo\">\r\n          See Dealality in Action\r\n        </button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</section><script src='https://cdn.prod.website-files.com/68108c29063eeb5d1bd7ae4a/6a6d621e55fe07fb96c584ed_old-home-manual-process.boot.v20260801f10.js' defer></script>"}}]}]}}]}