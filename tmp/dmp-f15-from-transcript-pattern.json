{"siteId":"68108c29063eeb5d1bd7ae4a","pageId":"68108c2a063eeb5d1bd7ae90","context":"Updates Manual Process CSS: muted problem body again; Email/Spreadsheets/Conversations white.","actions":[{"label":"set-embed-f15","set_settings":{"operations":[{"label":"code","element_id":{"component":"68108c2a063eeb5d1bd7ae90","element":"a64ef2f7-2f5f-ab92-9711-5f43f9eeb3fa"},"settings":[{"key":"code","static_text":{"value":"<link rel='stylesheet' href='https://cdn.prod.website-files.com/68108c29063eeb5d1bd7ae4a/6a6d6f8824a07ced4109566b_old-home-manual-process.shell.v20260731c.css' /><link rel='stylesheet' href='https://cdn.prod.website-files.com/68108c29063eeb5d1bd7ae4a/6a6d8271cf83f720d5b8c61b_old-home-manual-process.v20260801f15.css' /><section id=\"dealality-manual-process\" aria-labelledby=\"dmp-h2\" data-dmp-version=\"1.1.37\">\r\n  <div class=\"dmp-inner\">\r\n    <header class=\"dmp-header\">\r\n      <div class=\"dmp-badges\">\r\n        <div class=\"dmp-badge\" aria-label=\"The Problem: The Cost of a Manual Process\">\r\n          <span class=\"dmp-badge-left\">The Problem</span>\r\n          <span class=\"dmp-badge-right\">The Cost of a Manual Process</span>\r\n        </div>\r\n      </div>\r\n      <h2 id=\"dmp-h2\" class=\"dmp-h2\">The Hotel May Be Worth More<br />Than the Process Reveals.</h2>\r\n      <p class=\"dmp-lead\">\r\n        A manual process can produce a viable franchise or management agreement decision without proving it was the highest-value path for the asset.\r\n      </p>\r\n    </header>\r\n\r\n    <div\r\n      class=\"dmp-journey\"\r\n      role=\"img\"\r\n      aria-label=\"One hotel opportunity may have several credible strategic paths. In a manual process, information becomes fragmented and difficult to compare. One direction may move forward while other paths and questions remain unresolved.\"\r\n    >\r\n      <p id=\"dmp-visual-summary\" class=\"dmp-sr\">\r\n        One hotel opportunity may have several credible strategic paths. In a manual process, information becomes fragmented and difficult to compare. One direction may move forward while other paths and questions remain unresolved.\r\n      </p>\r\n\r\n      <div class=\"dmp-journey-row\">\r\n        <!-- Faint circular loops: Manual right → toward Opp (no touch) → Manual left -->\r\n        <div class=\"dmp-connectors dmp-connectors--desktop dmp-connectors--loops\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 1000 400\" preserveAspectRatio=\"none\" focusable=\"false\">\r\n            <path class=\"dmp-line-loop\" data-dmp-draw=\"loop\" d=\"M620 90 C560 40, 420 30, 300 80 C180 130, 260 200, 420 190\" stroke=\"rgba(255,255,255,0.7)\" stroke-width=\"1.25\"/>\r\n            <path class=\"dmp-line-loop\" data-dmp-draw=\"loop\" d=\"M630 150 C540 90, 380 70, 260 130 C140 190, 280 250, 430 230\" stroke=\"rgba(255,255,255,0.64)\" stroke-width=\"1.15\"/>\r\n            <path class=\"dmp-line-loop\" data-dmp-draw=\"loop\" d=\"M625 220 C580 280, 460 310, 340 270 C220 230, 300 160, 425 170\" stroke=\"rgba(255,255,255,0.68)\" stroke-width=\"1.2\"/>\r\n            <path class=\"dmp-line-loop\" data-dmp-draw=\"loop\" d=\"M635 280 C560 340, 400 360, 280 310 C160 260, 250 200, 415 210\" stroke=\"rgba(255,255,255,0.6)\" stroke-width=\"1.1\"/>\r\n            <path class=\"dmp-line-loop\" data-dmp-draw=\"loop\" d=\"M615 110 C500 160, 360 200, 240 170 C120 140, 220 90, 410 100\" stroke=\"rgba(255,255,255,0.56)\" stroke-width=\"1.05\"/>\r\n          </svg>\r\n        </div>\r\n        <!-- Column 1 -->\r\n        <article class=\"dmp-card dmp-card--opp\">\r\n          <h3 class=\"dmp-card-title\">One Hotel Opportunity</h3>\r\n          <div class=\"dmp-opp-body\">\r\n            <figure class=\"dmp-hotel-frame\">\r\n              <img\r\n                src=\"https://cdn.prod.website-files.com/68108c29063eeb5d1bd7ae4a/6a6d641e5ca8bb74e1c1a264_old-home-problem-historic-unrenovated.png\"\r\n                alt=\"\"\r\n                width=\"240\"\r\n                height=\"320\"\r\n                decoding=\"async\"\r\n                loading=\"lazy\"\r\n              />\r\n            </figure>\r\n            <ul class=\"dmp-paths\">\r\n              <li class=\"dmp-path\" data-dmp-path=\"0\">\r\n                <span class=\"dmp-path-icon\" aria-hidden=\"true\">\r\n                  <!-- Franchise: linked property network -->\r\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"3.2\" y=\"7.5\" width=\"6.2\" height=\"9.5\" rx=\"1.1\" stroke=\"currentColor\" stroke-width=\"1.45\"/><rect x=\"14.6\" y=\"7.5\" width=\"6.2\" height=\"9.5\" rx=\"1.1\" stroke=\"currentColor\" stroke-width=\"1.45\"/><path d=\"M9.4 12.2h5.2\" stroke=\"currentColor\" stroke-width=\"1.45\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"12.2\" r=\"1.25\" fill=\"currentColor\"/><path d=\"M5.2 10.2h2.2M16.6 10.2h2.2M5.2 12.8h2.2M16.6 12.8h2.2\" stroke=\"currentColor\" stroke-width=\"1.25\" stroke-linecap=\"round\"/></svg>\r\n                </span>\r\n                <span class=\"dmp-path-label\">Franchise</span>\r\n                <span class=\"dmp-path-dot\" aria-hidden=\"true\"></span>\r\n              </li>\r\n              <li class=\"dmp-path\" data-dmp-path=\"1\">\r\n                <span class=\"dmp-path-icon\" aria-hidden=\"true\">\r\n                  <!-- Management Agreement: operator with property key -->\r\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"9.2\" cy=\"7.4\" r=\"2.7\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M4.2 18.6c0-2.8 2.2-5 5-5s5 2.2 5 5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/><circle cx=\"17.3\" cy=\"11\" r=\"1.7\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M17.3 12.7v5.4M17.3 15.4h1.8\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\r\n                </span>\r\n                <span class=\"dmp-path-label\">Management Agreement</span>\r\n                <span class=\"dmp-path-dot\" aria-hidden=\"true\"></span>\r\n              </li>\r\n              <li class=\"dmp-path\" data-dmp-path=\"2\">\r\n                <span class=\"dmp-path-icon\" aria-hidden=\"true\">\r\n                  <!-- Independent: boutique hotel with standalone flag -->\r\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4.5 20V9.2L12 4.5l7.5 4.7V20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/><path d=\"M9.5 20v-4.8h5V20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/><path d=\"M8.2 11.2h1.6M14.2 11.2h1.6M8.2 14.2h1.6M14.2 14.2h1.6\" stroke=\"currentColor\" stroke-width=\"1.35\" stroke-linecap=\"round\"/><path d=\"M12 4.5V2.4\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/><path d=\"M12 2.4h4.2l-.9 1.4 1 1.4H12V2.4z\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linejoin=\"round\"/></svg>\r\n                </span>\r\n                <span class=\"dmp-path-label\">Independent</span>\r\n                <span class=\"dmp-path-dot\" aria-hidden=\"true\"></span>\r\n              </li>\r\n              <li class=\"dmp-path\" data-dmp-path=\"3\">\r\n                <span class=\"dmp-path-icon\" aria-hidden=\"true\">\r\n                  <!-- Soft Brand: light-affiliation seal / collection ribbon -->\r\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"9.6\" r=\"5\" stroke=\"currentColor\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"9.6\" r=\"2.2\" stroke=\"currentColor\" stroke-width=\"1.35\"/><path d=\"M9.1 14.2L7.8 20.2l4.2-2.1 4.2 2.1-1.3-6\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/><path d=\"M10.6 9.6h2.8M12 8.2v2.8\" stroke=\"currentColor\" stroke-width=\"1.25\" stroke-linecap=\"round\"/></svg>\r\n                </span>\r\n                <span class=\"dmp-path-label\">Soft Brand</span>\r\n                <span class=\"dmp-path-dot\" aria-hidden=\"true\"></span>\r\n              </li>\r\n              <li class=\"dmp-path\" data-dmp-path=\"4\">\r\n                <span class=\"dmp-path-icon\" aria-hidden=\"true\">\r\n                  <!-- Other Strategy: branching strategic paths -->\r\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 5.2v6.2\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/><path d=\"M12 11.4L6.2 18M12 11.4 17.8 18\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"4.4\" r=\"1.55\" stroke=\"currentColor\" stroke-width=\"1.35\"/><circle cx=\"6.2\" cy=\"18.4\" r=\"1.55\" stroke=\"currentColor\" stroke-width=\"1.35\"/><circle cx=\"17.8\" cy=\"18.4\" r=\"1.55\" stroke=\"currentColor\" stroke-width=\"1.35\"/></svg>\r\n                </span>\r\n                <span class=\"dmp-path-label\">Other Strategy</span>\r\n                <span class=\"dmp-path-dot\" aria-hidden=\"true\"></span>\r\n              </li>\r\n            </ul>\r\n          </div>\r\n          <p class=\"dmp-opp-foot\">Several credible paths may exist.</p>\r\n        </article>\r\n\r\n        <!-- Incoming connectors (desktop) — circular / spread; land across full Manual Process height -->\r\n        <div class=\"dmp-connectors dmp-connectors--desktop dmp-connectors--in\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 160 320\" preserveAspectRatio=\"none\" focusable=\"false\">\r\n            <!-- Clean starts at five dots; tangle mid-gap; disappear into Manual Process edge -->\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M0 36 C28 36, 48 20, 70 70 C92 120, 58 150, 96 130 C128 112, 140 118, 160 122\" stroke=\"#7eb6ff\" stroke-width=\"2.15\"/>\r\n            <path class=\"dmp-line-in dmp-line-in--dash\" data-dmp-draw=\"in\" d=\"M0 36 C22 55, 44 95, 62 120 C80 145, 110 100, 132 128 C148 146, 152 140, 160 136\" stroke=\"rgba(180,210,255,0.55)\" stroke-width=\"1.25\"/>\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M0 90 C34 78, 56 40, 74 88 C92 136, 48 170, 90 156 C126 144, 142 150, 160 154\" stroke=\"#6c9fff\" stroke-width=\"2.05\"/>\r\n            <path class=\"dmp-line-in dmp-line-in--dash\" data-dmp-draw=\"in\" d=\"M0 90 C26 120, 40 160, 72 170 C104 180, 118 140, 140 158 C152 168, 155 162, 160 160\" stroke=\"rgba(160,190,255,0.5)\" stroke-width=\"1.2\"/>\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M0 150 C36 130, 60 90, 68 140 C76 190, 110 200, 100 160 C90 120, 135 148, 160 156\" stroke=\"#8ec5ff\" stroke-width=\"2.2\"/>\r\n            <path class=\"dmp-line-in dmp-line-in--dash\" data-dmp-draw=\"in\" d=\"M0 150 C24 175, 52 210, 86 198 C120 186, 108 150, 136 168 C150 178, 154 170, 160 166\" stroke=\"rgba(200,220,255,0.45)\" stroke-width=\"1.15\"/>\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M0 210 C32 230, 58 270, 70 220 C82 170, 120 160, 105 200 C90 240, 138 210, 160 198\" stroke=\"#6c72ff\" stroke-width=\"2.05\"/>\r\n            <path class=\"dmp-line-in dmp-line-in--dash\" data-dmp-draw=\"in\" d=\"M0 210 C28 190, 55 150, 78 180 C101 210, 125 230, 140 200 C150 182, 154 188, 160 192\" stroke=\"rgba(170,185,255,0.48)\" stroke-width=\"1.2\"/>\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M0 268 C30 288, 62 300, 78 250 C94 200, 55 180, 98 210 C135 236, 144 220, 160 214\" stroke=\"#9bb8ff\" stroke-width=\"1.95\"/>\r\n            <path class=\"dmp-line-in dmp-line-in--dash\" data-dmp-draw=\"in\" d=\"M0 268 C40 250, 70 220, 88 240 C106 260, 130 270, 142 240 C152 220, 155 226, 160 230\" stroke=\"rgba(190,205,255,0.42)\" stroke-width=\"1.1\"/>\r\n          </svg>\r\n        </div>\r\n\r\n        <!-- Incoming connectors (mobile) — spread landings across Manual Process top edge -->\r\n        <div class=\"dmp-connectors dmp-connectors--mobile dmp-connectors--in\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 320 96\" preserveAspectRatio=\"none\" focusable=\"false\">\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d