nUse\">\r\n                <path d=\"M0 0.5 L5.4 3 L0 5.5 Z\" fill=\"rgba(255,255,255,0.88)\"/>\r\n              </marker>\r\n            </defs>\r\n            <!-- Varied vertical lengths — incomplete paths stop short of Selected Direction -->\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" marker-end=\"url(#dmp-dead-arrow-m)\" d=\"M160 0 C138 14, 148 28, 128 34 C108 40, 112 48, 98 52\" stroke=\"rgba(255,255,255,0.84)\" stroke-width=\"1.3\"/>\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" marker-end=\"url(#dmp-dead-arrow-m)\" d=\"M160 0 C146 18, 132 24, 136 44 C140 64, 118 60, 108 72\" stroke=\"rgba(255,255,255,0.78)\" stroke-width=\"1.2\"/>\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" marker-end=\"url(#dmp-dead-arrow-m)\" d=\"M160 0 C182 12, 174 30, 196 36 C218 42, 214 52, 228 56\" stroke=\"rgba(255,255,255,0.82)\" stroke-width=\"1.25\"/>\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" marker-end=\"url(#dmp-dead-arrow-m)\" d=\"M160 0 C176 20, 192 26, 186 46 C180 66, 208 58, 220 74\" stroke=\"rgba(255,255,255,0.76)\" stroke-width=\"1.2\"/>\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" marker-end=\"url(#dmp-dead-arrow-m)\" d=\"M160 0 C150 16, 168 28, 152 38 C136 48, 124 44, 116 54\" stroke=\"rgba(255,255,255,0.74)\" stroke-width=\"1.15\"/>\r\n            <path class=\"dmp-line-out-solid\" data-dmp-draw=\"out-solid\" d=\"M160 0 L160 112\" stroke=\"#c4b5fd\" stroke-width=\"2.5\"/>\r\n            <g class=\"dmp-dead-end\" transform=\"translate(98 52)\"><circle r=\"6.5\" fill=\"none\" stroke=\"rgba(255,255,255,0.82)\" stroke-width=\"1.1\"/><path d=\"M-2.8-2.8l5.6 5.6M2.8-2.8l-5.6 5.6\" stroke=\"rgba(255,255,255,0.9)\" stroke-width=\"1.1\" stroke-linecap=\"round\"/></g>\r\n            <g class=\"dmp-dead-end\" transform=\"translate(108 72)\"><circle r=\"6.5\" fill=\"none\" stroke=\"rgba(255,255,255,0.82)\" stroke-width=\"1.1\"/><path d=