{"code":"<!-- Old Home Manual Process v1.1 — immutable CDN assets; do not overwrite -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter+Tight:wght@400;500;600;700&display=swap\" rel=\"stylesheet\" />\n<link rel=\"stylesheet\" href=\"https://cdn.prod.website-files.com/68108c29063eeb5d1bd7ae4a/6a6cd9146403b81b28b3a9bf_old-home-manual-process.v20260731a.css\" />\n<style id=\"dmp-shell-neutralize\">\n/* Scoped shell neutralize so #about padding does not inflate approved heights */\n#about[data-oh-problem=\"manual-process\"]{\n  padding-top:0!important;\n  padding-bottom:0!important;\n}\n#about[data-oh-problem=\"manual-process\"] .oh-problem-shell{\n  max-width:none!important;\n  width:100%!important;\n  margin:0!important;\n  padding:0!important;\n}\n#about[data-oh-problem=\"manual-process\"] .oh-problem-stage{\n  margin:0!important;\n  padding:0!important;\n  min-height:0!important;\n}\n</style>\n<section id=\"dealality-manual-process\" aria-labelledby=\"dmp-h2\" data-dmp-version=\"1.1\">\r\n  <div class=\"dmp-inner\">\r\n    <header class=\"dmp-header\">\r\n      <p class=\"dmp-eyebrow\">The Cost of a Manual Process</p>\r\n      <h2 id=\"dmp-h2\" class=\"dmp-h2\">The Hotel May Be Worth More<br />Than the Process Reveals.</h2>\r\n      <p class=\"dmp-lead\">\r\n        A manual process can produce a viable decision without proving that it was the highest-value decision for the asset.\r\n      </p>\r\n    </header>\r\n\r\n    <div\r\n      class=\"dmp-journey\"\r\n      role=\"img\"\r\n      aria-label=\"One hotel opportunity may have several credible strategic paths. In a manual process, information becomes fragmented and difficult to compare. One direction may move forward while other paths and questions remain unresolved.\"\r\n    >\r\n      <p id=\"dmp-visual-summary\" class=\"dmp-sr\">\r\n        One hotel opportunity may have several credible strategic paths. In a manual process, information becomes fragmented and difficult to compare. One direction may move forward while other paths and questions remain unresolved.\r\n      </p>\r\n\r\n      <div class=\"dmp-journey-row\">\r\n        <!-- Column 1 -->\r\n        <article class=\"dmp-card dmp-card--opp\">\r\n          <h3 class=\"dmp-card-title\">One Hotel Opportunity</h3>\r\n          <div class=\"dmp-opp-body\">\r\n            <figure class=\"dmp-hotel-frame\">\r\n              <img\r\n                src=\"https://cdn.jsdelivr.net/gh/joandejarden-create/my-operators-backend@ddf8f57d8b1d927c815fbffc4dba88f8f884b118/webflow-embeds/many-futures/assets/hotel-final-640.webp\"\r\n                alt=\"\"\r\n                width=\"240\"\r\n                height=\"360\"\r\n                decoding=\"async\"\r\n                loading=\"lazy\"\r\n              />\r\n              <figcaption class=\"dmp-hotel-caption\">Metropolitan Hotel</figcaption>\r\n            </figure>\r\n            <ul class=\"dmp-paths\">\r\n              <li class=\"dmp-path\" data-dmp-path=\"0\">\r\n                <span class=\"dmp-path-icon\" aria-hidden=\"true\">\r\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3.5l2.2 4.5 5 .7-3.6 3.5.9 5L12 15.4 7.5 17.2l.9-5L4.8 8.7l5-.7L12 3.5z\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/></svg>\r\n                </span>\r\n                <span class=\"dmp-path-label\">Rebrand</span>\r\n                <span class=\"dmp-path-dot\" aria-hidden=\"true\"></span>\r\n              </li>\r\n              <li class=\"dmp-path\" data-dmp-path=\"1\">\r\n                <span class=\"dmp-path-icon\" aria-hidden=\"true\">\r\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"8\" r=\"3.2\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M5.5 19c0-3.4 2.9-6 6.5-6s6.5 2.6 6.5 6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>\r\n                </span>\r\n                <span class=\"dmp-path-label\">New operator</span>\r\n                <span class=\"dmp-path-dot\" aria-hidden=\"true\"></span>\r\n              </li>\r\n              <li class=\"dmp-path\" data-dmp-path=\"2\">\r\n                <span class=\"dmp-path-icon\" aria-hidden=\"true\">\r\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 19V8.5L12 4l8 4.5V19\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/><path d=\"M9 19v-5h6v5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/></svg>\r\n                </span>\r\n                <span class=\"dmp-path-label\">Independent</span>\r\n                <span class=\"dmp-path-dot\" aria-hidden=\"true\"></span>\r\n              </li>\r\n              <li class=\"dmp-path\" data-dmp-path=\"3\">\r\n                <span class=\"dmp-path-icon\" aria-hidden=\"true\">\r\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 5l1.4 2.9 3.2.5-2.3 2.2.5 3.2L12 12.4 9.2 13.8l.5-3.2-2.3-2.2 3.2-.5L12 5z\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/><circle cx=\"12\" cy=\"12\" r=\"8.5\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".45\"/></svg>\r\n                </span>\r\n                <span class=\"dmp-path-label\">Soft brand</span>\r\n                <span class=\"dmp-path-dot\" aria-hidden=\"true\"></span>\r\n              </li>\r\n              <li class=\"dmp-path\" data-dmp-path=\"4\">\r\n                <span class=\"dmp-path-icon\" aria-hidden=\"true\">\r\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"6\" cy=\"12\" r=\"1.6\" fill=\"currentColor\"/><circle cx=\"12\" cy=\"12\" r=\"1.6\" fill=\"currentColor\"/><circle cx=\"18\" cy=\"12\" r=\"1.6\" fill=\"currentColor\"/></svg>\r\n                </span>\r\n                <span class=\"dmp-path-label\">Other strategy</span>\r\n                <span class=\"dmp-path-dot\" aria-hidden=\"true\"></span>\r\n              </li>\r\n            </ul>\r\n          </div>\r\n          <p class=\"dmp-opp-foot\">Several credible paths may exist.</p>\r\n        </article>\r\n\r\n        <!-- Incoming connectors (desktop) -->\r\n        <div class=\"dmp-connectors dmp-connectors--desktop dmp-connectors--in\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 140 420\" preserveAspectRatio=\"none\" focusable=\"false\">\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M0 52 C34 52, 22 210, 64 250 S108 140, 140 210\" stroke=\"#c4b5fd\" stroke-width=\"2.1\"/>\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M0 118 C46 70, 18 300, 76 170 S118 250, 140 210\" stroke=\"#9b8afb\" stroke-width=\"1.85\"/>\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M0 184 C28 184, 58 70, 70 300 S112 320, 140 210\" stroke=\"#a78bfa\" stroke-width=\"2\"/>\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M0 250 C52 300, 24 60, 86 140 S122 270, 140 210\" stroke=\"#818cf8\" stroke-width=\"1.75\"/>\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M0 316 C38 360, 68 190, 92 290 S118 150, 140 210\" stroke=\"#6c72ff\" stroke-width=\"1.95\"/>\r\n          </svg>\r\n        </div>\r\n\r\n        <!-- Incoming connectors (mobile) -->\r\n        <div class=\"dmp-connectors dmp-connectors--mobile dmp-connectors--in\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 320 88\" preserveAspectRatio=\"none\" focusable=\"false\">\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M40 0 C40 28, 120 20, 160 44 S240 70, 280 88\" stroke=\"#c4b5fd\" stroke-width=\"2\"/>\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M80 0 C70 36, 200 12, 160 48 S100 64, 280 88\" stroke=\"#9b8afb\" stroke-width=\"1.7\"/>\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M120 0 C150 24, 90 50, 170 56 S220 40, 280 88\" stroke=\"#a78bfa\" stroke-width=\"1.8\"/>\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M160 0 C200 30, 60 40, 140 60 S250 50, 280 88\" stroke=\"#818cf8\" stroke-width=\"1.6\"/>\r\n            <path class=\"dmp-line-in\" data-dmp-draw=\"in\" d=\"M200 0 C230 22, 180 55, 150 50 S240 70, 280 88\" stroke=\"#6c72ff\" stroke-width=\"1.8\"/>\r\n          </svg>\r\n        </div>\r\n\r\n        <!-- Column 2 -->\r\n        <article class=\"dmp-card dmp-card--manual\">\r\n          <h3 class=\"dmp-card-title\">Manual Process</h3>\r\n          <ul class=\"dmp-manual-list\">\r\n            <li class=\"dmp-manual-item\">\r\n              <span class=\"dmp-manual-icon\" aria-hidden=\"true\">\r\n                <svg viewBox=\"0 0 40 40\" fill=\"none\"><rect x=\"6\" y=\"10\" width=\"28\" height=\"20\" rx=\"3\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M6 14l14 9 14-9\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/></svg>\r\n              </span>\r\n              <span class=\"dmp-manual-label\">Email</span>\r\n            </li>\r\n            <li class=\"dmp-manual-item\">\r\n              <span class=\"dmp-manual-icon\" aria-hidden=\"true\">\r\n                <svg viewBox=\"0 0 40 40\" fill=\"none\"><rect x=\"7\" y=\"8\" width=\"26\" height=\"24\" rx=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M7 16h26M7 24h26M15 8v24M25 8v24\" stroke=\"currentColor\" stroke-width=\"1.3\" opacity=\".7\"/></svg>\r\n              </span>\r\n              <span class=\"dmp-manual-label\">Spreadsheets</span>\r\n            </li>\r\n            <li class=\"dmp-manual-item\">\r\n              <span class=\"dmp-manual-icon\" aria-hidden=\"true\">\r\n                <svg viewBox=\"0 0 40 40\" fill=\"none\"><path d=\"M8 12c0-2 1.7-3.5 4-3.5h12c2.3 0 4 1.5 4 3.5v8c0 2-1.7 3.5-4 3.5H18l-5 5v-5h-1c-2.3 0-4-1.5-4-3.5v-8z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/><path d=\"M26 22.5c1.8.4 3.5 1.4 3.5 3.3v2.2c0 1.4-1.2 2.5-2.8 2.5h-.7l-3.2 3.2v-3.2h-.5\" stroke=\"currentColor\" stroke-width=\"1.4\" opacity=\".65\" stroke-linecap=\"round\"/></svg>\r\n              </span>\r\n              <span class=\"dmp-manual-label\">Separate conversations</span>\r\n            </li>\r\n          </ul>\r\n        </article>\r\n\r\n        <!-- Outgoing connectors (desktop) — one solid + dotted unresolved (no X / no end circles) -->\r\n        <div class=\"dmp-connectors dmp-connectors--desktop dmp-connectors--out\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 120 420\" preserveAspectRatio=\"none\" focusable=\"false\">\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" d=\"M0 150 C28 120, 48 70, 78 48\" stroke=\"#a78bfa\" stroke-width=\"1.5\"/>\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" d=\"M0 175 C34 155, 58 110, 92 92\" stroke=\"#818cf8\" stroke-width=\"1.4\"/>\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" d=\"M0 245 C30 270, 55 320, 86 348\" stroke=\"#9b8afb\" stroke-width=\"1.5\"/>\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" d=\"M0 270 C36 295, 62 350, 95 372\" stroke=\"#6c72ff\" stroke-width=\"1.4\"/>\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" d=\"M0 195 C40 185, 70 160, 100 148\" stroke=\"#c4b5fd\" stroke-width=\"1.35\"/>\r\n            <path class=\"dmp-line-out-solid\" data-dmp-draw=\"out-solid\" d=\"M0 210 L120 210\" stroke=\"#c4b5fd\" stroke-width=\"2.5\"/>\r\n          </svg>\r\n        </div>\r\n\r\n        <div class=\"dmp-connectors dmp-connectors--mobile dmp-connectors--out\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 320 100\" preserveAspectRatio=\"none\" focusable=\"false\">\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" d=\"M160 0 C120 28, 70 40, 42 58\" stroke=\"#a78bfa\" stroke-width=\"1.5\"/>\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" d=\"M160 0 C130 34, 90 50, 70 72\" stroke=\"#818cf8\" stroke-width=\"1.4\"/>\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" d=\"M160 0 C200 30, 250 42, 278 60\" stroke=\"#9b8afb\" stroke-width=\"1.5\"/>\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" d=\"M160 0 C210 36, 255 55, 290 74\" stroke=\"#6c72ff\" stroke-width=\"1.4\"/>\r\n            <path class=\"dmp-line-out-dot\" data-dmp-draw=\"out-dot\" d=\"M160 0 C145 40, 100 55, 88 80\" stroke=\"#c4b5fd\" stroke-width=\"1.35\"/>\r\n            <path class=\"dmp-line-out-solid\" data-dmp-draw=\"out-solid\" d=\"M160 0 L160 100\" stroke=\"#c4b5fd\" stroke-width=\"2.5\"/>\r\n          </svg>\r\n        </div>\r\n\r\n        <!-- Column 3 -->\r\n        <article class=\"dmp-card dmp-card--selected\">\r\n          <h3 class=\"dmp-card-title\">Selected Direction</h3>\r\n          <div class=\"dmp-selected-media\">\r\n            <img\r\n              src=\"https://cdn.prod.website-files.com/68108c29063eeb5d1bd7ae4a/6a6bde85c014ee4e80e65c24_deal-desk-coastal-hotel-480.jpg\"\r\n              alt=\"\"\r\n              width=\"480\"\r\n              height=\"320\"\r\n              decoding=\"async\"\r\n              loading=\"lazy\"\r\n            />\r\n          </div>\r\n          <div class=\"dmp-decision-mark\" aria-hidden=\"true\">\r\n            <svg viewBox=\"0 0 40 40\" fill=\"none\">\r\n              <circle cx=\"20\" cy=\"20\" r=\"15\" stroke=\"#fdb52a\" stroke-width=\"1.6\"/>\r\n              <path d=\"M20 10.5l2.1 4.3 4.7.7-3.4 3.3.8 4.7L20 21.2l-4.2 2.3.8-4.7-3.4-3.3 4.7-.7L20 10.5z\" stroke=\"#fdb52a\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/>\r\n            </svg>\r\n          </div>\r\n          <ol class=\"dmp-questions\">\r\n            <li class=\"dmp-q\">\r\n              <span class=\"dmp-q-num\" aria-hidden=\"true\">1</span>\r\n              <span class=\"dmp-q-text\">Was the strongest path explored?</span>\r\n            </li>\r\n            <li class=\"dmp-q\">\r\n              <span class=\"dmp-q-num\" aria-hidden=\"true\">2</span>\r\n              <span class=\"dmp-q-text\">Were the economics truly comparable?</span>\r\n            </li>\r\n            <li class=\"dmp-q\">\r\n              <span class=\"dmp-q-num\" aria-hidden=\"true\">3</span>\r\n              <span class=\"dmp-q-text\">What value was never uncovered?</span>\r\n            </li>\r\n          </ol>\r\n        </article>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"dmp-problems\">\r\n      <article class=\"dmp-problem\">\r\n        <div class=\"dmp-problem-icon\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 40 40\" fill=\"none\">\r\n            <path d=\"M8 20c8-14 16 14 24 0\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\r\n            <path d=\"M8 24c8 12 16-12 24 0\" stroke=\"currentColor\" stroke-width=\"1.4\" opacity=\".55\" stroke-linecap=\"round\"/>\r\n            <path d=\"M12 12c6 8 10-8 16 4\" stroke=\"currentColor\" stroke-width=\"1.3\" opacity=\".7\" stroke-linecap=\"round\"/>\r\n          </svg>\r\n        </div>\r\n        <div class=\"dmp-problem-text\">\r\n          <h3 class=\"dmp-problem-h\">Fragmented Process</h3>\r\n          <p class=\"dmp-problem-p\">Critical information stays spread across emails, spreadsheets, and separate conversations.</p>\r\n        </div>\r\n      </article>\r\n      <article class=\"dmp-problem\">\r\n        <div class=\"dmp-problem-icon\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 40 40\" fill=\"none\">\r\n            <rect x=\"8\" y=\"7\" width=\"18\" height=\"24\" rx=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\r\n            <path d=\"M12 14h10M12 19h10M12 24h7\" stroke=\"currentColor\" stroke-width=\"1.3\" opacity=\".65\" stroke-linecap=\"round\"/>\r\n            <circle cx=\"28\" cy=\"27\" r=\"6\" stroke=\"currentColor\" stroke-width=\"1.5\"/>\r\n            <path d=\"M28 24.5v3l2 1.2\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\r\n          </svg>\r\n        </div>\r\n        <div class=\"dmp-problem-text\">\r\n          <h3 class=\"dmp-problem-h\">Comparison Weakened</h3>\r\n          <p class=\"dmp-problem-p\">Different participants review and return information in different formats, making paths harder to compare consistently.</p>\r\n        </div>\r\n      </article>\r\n      <article class=\"dmp-problem\">\r\n        <div class=\"dmp-problem-icon\" aria-hidden=\"true\">\r\n          <svg viewBox=\"0 0 40 40\" fill=\"none\">\r\n            <path d=\"M8 28V18M16 28V12M24 28V16M32 28V10\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\r\n            <path d=\"M6 30h28\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\r\n            <path d=\"M10 14l6-4 6 3 8-7\" stroke=\"currentColor\" stroke-width=\"1.3\" opacity=\".55\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n          </svg>\r\n        </div>\r\n        <div class=\"dmp-problem-text\">\r\n          <h3 class=\"dmp-problem-h\">Value Left Unseen</h3>\r\n          <p class=\"dmp-problem-p\">A decision can move forward without proving which path creates the most value.</p>\r\n        </div>\r\n      </article>\r\n    </div>\r\n\r\n    <div class=\"dmp-close\">\r\n      <p class=\"dmp-close-q\">\r\n        <span>A Decision Was Reached.</span>\r\n        <span>But Did the Process Leave Value Unexplored?</span>\r\n      </p>\r\n      <a class=\"dmp-cta\" href=\"https://www.dealality.com/opportunity-review\">\r\n        <span>See Dealality in Action</span>\r\n        <span class=\"dmp-cta-arrow\" aria-hidden=\"true\">&#8594;</span>\r\n      </a>\r\n    </div>\r\n  </div>\r\n</section>\n<script src=\"https://cdn.prod.website-files.com/68108c29063eeb5d1bd7ae4a/6a6cd9140230e8c779bd70c9_old-home-manual-process.v20260731a.js\" defer></script>\n"}