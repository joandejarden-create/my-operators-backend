ass=\"dpd-arts\">\n              <article class=\"dpd-doc dpd-doc--primary dpd-doc--note\" aria-label=\"Notes\">\n                <div class=\"dpd-doc-body dpd-sticky\">\n                  <span class=\"dpd-sticky-pin\"></span>\n                  <i></i><i></i><i></i>\n                </div>\n                <p class=\"dpd-doc-cap\">Notes</p>\n              </article>\n              <article class=\"dpd-doc dpd-doc--primary dpd-doc--proposal\" aria-label=\"Market study\">\n                <div class=\"dpd-doc-body dpd-proposal dpd-proposal--teal\">\n                  <span class=\"dpd-prop-badge\">PDF</span>\n                  <div class=\"dpd-prop-cover\"><span></span><b></b><i></i></div>\n                </div>\n                <p class=\"dpd-doc-cap\">Market Study</p>\n              </article>\n              <article class=\"dpd-doc dpd-doc--depth dpd-doc--call\" aria-hidden=\"true\">\n                <div class=\"dpd-doc-body dpd-wavebox dpd-wavebox--teal\">\n                  <div class=\"dpd-wave\"><i style=\"--h:50%\"></i><i style=\"--h:30%\"></i><i style=\"--h:78%\"></i><i style=\"--h:44%\"></i></div>\n                </div>\n              </article>\n            </div>\n          </div>\n\n          <div class=\"dpd-lane dpd-lane--capital\">\n            <div class=\"dpd-lane-h\"><div class=\"dpd-avatar\" aria-hidden=\"true\"></div><p class=\"dpd-lane-name\">Capital Partner</p></div>\n            <div class=\"dpd-copy-hint\" aria-hidden=\"true\"><span>Opportunity Copy</span></div>\n            <div class=\"dpd-arts\">\n              <article class=\"dpd-doc dpd-doc--primary dpd-doc--termsheet\" aria-label=\"Term sheet\">\n                <div class=\"dpd-doc-body dpd-legal\">\n                  <div class=\"dpd-legal-title\"></div>\n                  <div class=\"dpd-legal-clause\"></div>\n                  <div class=\"dpd-legal-clause short\"></div>\n                  <div class=\"dpd-legal-clause\"></div>\n                </div>\n                <p class