p></div>\n            <div class=\"dpd-rail\" aria-hidden=\"true\"><div class=\"dpd-rail-fill dpd-rail-fill--48\"></div></div>\n          </div>\n          <div class=\"dpd-track\">\n            <div class=\"dpd-track-top\"><p class=\"dpd-track-name\">Path C</p><p class=\"dpd-track-status\">Awaiting Information</p></div>\n            <div class=\"dpd-rail\" aria-hidden=\"true\"><div class=\"dpd-rail-fill dpd-rail-fill--28\"></div></div>\n          </div>\n          <div class=\"dpd-track\">\n            <div class=\"dpd-track-top\"><p class=\"dpd-track-name\">Path D</p><p class=\"dpd-track-status\">Not Yet Tested</p></div>\n            <div class=\"dpd-rail\" aria-hidden=\"true\"><div class=\"dpd-rail-fill dpd-rail-fill--12\"></div></div>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"dpd-zone dpd-zone--outcome\" data-zone=\"outcome\" aria-label=\"Consequence\">\n        <p class=\"dpd-zone-label\">Outcome</p>\n        <div class=\"dpd-ghost\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 280 200\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <circle cx=\"140\" cy=\"28\" r=\"7\" fill=\"#9B8AFB\" opacity=\".55\"/>\n            <path d=\"M140 36 C90 80, 48 110, 32 168\" stroke=\"#9B8AFB\" stroke-width=\"1.6\" opacity=\".4\" stroke-dasharray=\"3 5\"/>\n            <path d=\"M140 36 C140 80, 140 110, 140 168\" stroke=\"#9B8AFB\" stroke-width=\"1.7\" opacity=\".3\" stroke-dasharray=\"3 5\"/>\n            <path d=\"M140 36 C190 80, 232 110, 248 168\" stroke=\"#9B8AFB\" stroke-width=\"1.6\" opacity=\".4\" stroke-dasharray=\"3 5\"/>\n            <circle cx=\"32\" cy=\"172\" r=\"6\" stroke=\"#9B8AFB\" stroke-dasharray=\"2 2\" opacity=\".55\"/>\n            <circle cx=\"140\" cy=\"172\" r=\"6\" stroke=\"#9B8AFB\" stroke-dasharray=\"2 2\" opacity=\".35\"/>\n            <circle cx=\"248\" cy=\"172\" r=\"6\" stroke=\"#9B8AFB\" stroke-dasharray=\"2 2\" opacity=\".55\"/>\n          </svg>\n        </div>\n        <div class=\"dpd-outcome-inner\">\n          <h3 class=\"dpd-outcome-title\">Potential Value Stays Hidden.</h3>\n          <p class=\"dpd-outcome-body\">Incomplete comparisons leave credible paths unexplored.</p>\n          <div class=\"dpd-locks\" aria-hidden=\"true\">\n            <div class=\"dpd-lock\"></div><div class=\"dpd-lock\"></div><div class=\"dpd-lock\"></div>\n          </div>\n        </div>\n      </section>\n    </div>\n  </div>\n</div>\n"}}]}]}}]}