{"siteId":"68108c29063eeb5d1bd7ae4a","pageId":"68108c2a063eeb5d1bd7ae90","context":"Replace temporary polish-v2 probe with cinematic-v1 Deal Desk HtmlEmbed markup and scoped CSS import.","actions":[{"label":"set_cinematic_v1","set_settings":{"operations":[{"label":"embed_code","element_id":{"component":"68108c2a063eeb5d1bd7ae90","element":"a64ef2f7-2f5f-ab92-9711-5f43f9eeb3fa"},"settings":[{"key":"code","static_text":{"value":"<style id=\"oh-deal-desk\">@import url(\"https://cdn.prod.website-files.com/68108c29063eeb5d1bd7ae4a/6a6c3db76db7f7c28a1f6fe0_oh-deal-desk-cinematic-v1.css\");</style>\n<div class=\"dealality-problem-desk\" data-dealality-problem-desk data-story-state=\"opportunity\" data-visual=\"cinematic-v1\" aria-hidden=\"false\">\n  <p class=\"dpd-sr-only\">One hotel opportunity is distributed across separate brand, operator, advisor, and capital workstreams. Each workstream generates different emails, proposals, spreadsheets, notes, and requests. The responses use different information and assumptions, making comparison difficult. One path may gain momentum before other credible options are fully evaluated, leaving potential value undiscovered.</p>\n  <div class=\"dpd-desk\">\n    <svg class=\"dpd-flow-lines\" viewBox=\"0 0 1180 720\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n      <defs>\n        <linearGradient id=\"dpdFlowGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0%\" stop-color=\"#9B8AFB\" stop-opacity=\".55\"/><stop offset=\"55%\" stop-color=\"#60A5FA\" stop-opacity=\".28\"/><stop offset=\"100%\" stop-color=\"#9B8AFB\" stop-opacity=\".12\"/></linearGradient>\n      </defs>\n      <path class=\"dpd-path dpd-path--a\" d=\"M280 180 C360 180, 420 140, 520 140\" stroke=\"url(#dpdFlowGrad)\" stroke-width=\"2\" fill=\"none\"/>\n      <path class=\"dpd-path dpd-path--b\" d=\"M280 320 C360 320, 420 280, 520 280\" stroke=\"url(#dpdFlowGrad)\" stroke-width=\"1.8\" fill=\"none\"/>\n      <path class=\"dpd-path dpd-path--c\" d=\"M280 460 C360 460, 420 420, 520 420\" stroke=\"url(#dpdFlowGrad)\" stroke-width=\"1.8\" fill=\"none\"/>\n      <path class=\"dpd-path dpd-path--d\" d=\"M280 560 C360 560, 420 540, 520 540\" stroke=\"url(#dpdFlowGrad)\" stroke-width=\"1.8\" fill=\"none\"/>\n      <path class=\"dpd-path dpd-path--mid\" d=\"M760 360 C840 360, 900 360, 980 360\" stroke=\"url(#dpdFlowGrad)\" stroke-width=\"1.6\" fill=\"none\" opacity=\".7\"/>\n    </svg>\n\n    <div class=\"dpd-stage\" aria-label=\"Deal Desk storyboard\">\n      <section class=\"dpd-zone dpd-zone--opp\" data-zone=\"opportunity\" aria-label=\"Hotel opportunity\">\n        <p class=\"dpd-zone-label\">Opportunity</p>\n        <div class=\"dpd-ghost-paths\" aria-hidden=\"true\">\n          <span class=\"dpd-ghost-path\"></span>\n          <span class=\"dpd-ghost-path\"></span>\n          <span class=\"dpd-ghost-path\"></span>\n          <span class=\"dpd-ghost-path\"></span>\n        </div>\n        <div class=\"dpd-hotel-card\">\n          <div class=\"dpd-hotel-media\" aria-hidden=\"true\">\n            <img class=\"dpd-hotel-img\" src=\"https://cdn.prod.website-files.com/68108c29063eeb5d1bd7ae4a/6a6bde85c014ee4e80e65c24_deal-desk-coastal-hotel-480.jpg\" alt=\"\" width=\"480\" height=\"320\" decoding=\"async\"/>\n            <div class=\"dpd-hotel-shade\"></div>\n            <span class=\"dpd-hotel-chip\">Owner-Led Review</span>\n          </div>\n          <div class=\"dpd-opp-copy\">\n            <p class=\"dpd-opp-title\">One Hotel Opportunity</p>\n            <p class=\"dpd-opp-meta\">Coastal Select-Service Hotel</p>\n          </div>\n        </div>\n        <div class=\"dpd-fields\">\n          <div class=\"dpd-field\"><span class=\"dpd-field-dot\" aria-hidden=\"true\"></span><span>Owner Objectives</span></div>\n          <div class=\"dpd-field\"><span class=\"dpd-field-dot\" aria-hidden=\"true\"></span><span>Market Context</span></div>\n          <div class=\"dpd-field\"><span class=\"dpd-field-dot\" aria-hidden=\"true\"></span><span>Commercial Priorities</span></div>\n          <div class=\"dpd-field\"><span class=\"dpd-field-dot\" aria-hidden=\"true\"></span><span>Capital Constraints</span></div>\n        </div>\n      </section>\n\n      <section class=\"dpd-zone dpd-zone--streams\" data-zone=\"workstreams\" aria-label=\"Four separate workstreams\">\n        <p class=\"dpd-zone-label\">Workstreams</p>\n        <div class=\"dpd-lanes\">\n          <div class=\"dpd-lane dpd-lane--brand\">\n            <div class=\"dpd-lane-h\"><div class=\"dpd-avatar\" aria-hidden=\"true\"></div><p class=\"dpd-lane-name\">Brand Team</p></div>\n            <div class=\"dpd-copy-hint\" aria-hidden=\"true\"><span>Opportunity Copy</span></div>\n            <div class=\"dpd-arts\">\n              <article class=\"dpd-doc dpd-doc--primary dpd-doc--email\" aria-label=\"Email\">\n                <div class=\"dpd-doc-body\">\n                  <div class=\"dpd-mail-head\"><span class=\"dpd-mail-dot\"></span><span class=\"dpd-mail-from\">Brand Dev</span></div>\n                  <p class=\"dpd-mail-subj\">Flag opportunity?</p>\n                  <div class=\"dpd-mail-lines\"><i></i><i></i><i></i></div>\n                </div>\n                <p class=\"dpd-doc-cap\">Email</p>\n              </article>\n              <article class=\"dpd-doc dpd-doc--primary dpd-doc--proposal\" aria-label=\"Proposal\">\n                <div class=\"dpd-doc-body dpd-proposal\">\n                  <span class=\"dpd-prop-badge\">PDF</span>\n                  <div class=\"dpd-prop-cover\"><span></span><b></b><i></i></div>\n                </div>\n                <p class=\"dpd-doc-cap\">Proposal</p>\n              </article>\n              <article class=\"dpd-doc dpd-doc--depth dpd-doc--deck\" aria-hidden=\"true\">\n                <div class=\"dpd-doc-body dpd-slides\"><span></span><span></span></div>\n              </article>\n            </div>\n          </div>\n\n          <div class=\"dpd-lane dpd-lane--operator\">\n      