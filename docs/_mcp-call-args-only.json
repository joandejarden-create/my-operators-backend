-diff\" role=\"cell\"><span class=\"dpd-st-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><path d=\"M4 5h8M4 11h8M5.5 3.5v9M10.5 3.5v9\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg></span><span class=\"dpd-st-txt\">Different Basis</span></div>\n            <div class=\"dpd-st dpd-st--partial\" role=\"cell\"><span class=\"dpd-st-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><circle cx=\"8\" cy=\"8\" r=\"5\" stroke=\"currentColor\" stroke-width=\"1.7\" fill=\"none\" stroke-dasharray=\"10 7\"/></svg></span><span class=\"dpd-st-txt\">Partial</span></div>\n            <div class=\"dpd-st dpd-st--ok\" role=\"cell\"><span class=\"dpd-st-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><path d=\"M3.2 8.2l3 3 6.4-6.6\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/></svg></span><span class=\"dpd-st-txt\">Complete</span></div>\n          </div>\n          <div class=\"dpd-compare-row\" role=\"row\">\n            <div class=\"dpd-rl\" role=\"rowheader\">Owner Control</div>\n            <div class=\"dpd-st dpd-st--partial\" role=\"cell\"><span class=\"dpd-st-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><circle cx=\"8\" cy=\"8\" r=\"5\" stroke=\"currentColor\" stroke-width=\"1.7\" fill=\"none\" stroke-dasharray=\"10 7\"/></svg></span><span class=\"dpd-st-txt\">Partial</span></div>\n            <div class=\"dpd-st dpd-st--ok\" role=\"cell\"><span class=\"dpd-st-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><path d=\"M3.2 8.2l3 3 6.4-6.6\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/></svg></span><span class=\"dpd-st-txt\">Complete</span></div>\n            <div class=\"dpd-st dpd-st--unclear\" role=\"cell\"><span class=\"dpd-st-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><circle cx=\"8\" cy=\"8\" r=\"5\" stroke=\"currentColor\" stroke-width=\"1.7\" fill=\"none\"/><path d=\"M8 5v3.2M8 11.2h.01\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg></span><span class=\"dpd-st-txt\">Unclear</span></div>\n            <div class=\"dpd-st dpd-st--miss\" role=\"cell\"><span class=\"dpd-st-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><path d=\"M5 5l6 6M11 5l-6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg></span><span class=\"dpd-st-txt\">Missing</span></div>\n          </div>\n          <div class=\"dpd-compare-row\" role=\"row\">\n            <div class=\"dpd-rl\" role=\"rowheader\">Timing</div>\n            <div class=\"dpd-st dpd-st--diff\" role=\"cell\"><span class=\"dpd-st-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><path d=\"M4 5h8M4 11h8M5.5 3.5v9M10.5 3.5v9\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg></span><span class=\"dpd-st-txt\">Different Basis</span></div>\n            <div class=\"dpd-st dpd-st--diff\" role=\"cell\"><span class=\"dpd-st-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><path d=\"M4 5h8M4 11h8M5.5 3.5v9M10.5 3.5v9\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg></span><span class=\"dpd-st-txt\">Different Basis</span></div>\n            <div class=\"dpd-st dpd-st--partial\" role=\"cell\"><span class=\"dpd-st-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><circle cx=\"8\" cy=\"8\" r=\"5\" stroke=\"currentColor\" stroke-width=\"1.7\" fill=\"none\" stroke-dasharray=\"10 7\"/></svg></span><span class=\"dpd-st-txt\">Partial</span></div>\n            <div class=\"dpd-st dpd-st--ok\" role=\"cell\"><span class=\"dpd-st-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><path d=\"M3.2 8.2l3 3 6.4-6.6\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/></svg></span><span class=\"dpd-st-txt\">Complete</span></div>\n          </div>\n          <div class=\"dpd-compare-row\" role=\"row\">\n            <div class=\"dpd-rl\" role=\"rowheader\">Missing Information</div>\n            <div class=\"dpd-st dpd-st--miss\" role=\"cell\"><span class=\"dpd-st-ico\" aria-hidden