             <article class=\"dpd-doc dpd-doc--note\" aria-label=\"Advisor note\">\n                <div class=\"dpd-doc-body dpd-sticky\">\n                  <span class=\"dpd-sticky-pin\"></span>\n                  <i></i><i></i><i></i>\n                </div>\n                <p class=\"dpd-doc-cap\">Notes</p>\n              </article>\n              <article class=\"dpd-doc dpd-doc--proposal\" aria-label=\"Market study\">\n                <div class=\"dpd-doc-stack\" aria-hidden=\"true\"></div>\n                <div class=\"dpd-doc-body dpd-proposal dpd-proposal--teal\">\n                  <span class=\"dpd-prop-badge\">PDF</span>\n                  <div class=\"dpd-prop-cover\"><span></span><b></b><i></i></div>\n                </div>\n                <p class=\"dpd-doc-cap\">Study</p>\n              </article>\n              <article class=\"dpd-doc dpd-doc--call\" aria-label=\"Advisor call\">\n                <div class=\"dpd-doc-body dpd-wavebox dpd-wavebox--teal\">\n                  <div class=\"dpd-wave\"><i style=\"--h:50%\"></i><i style=\"--h:30%\"></i><i style=\"--h:78%\"></i><i style=\"--h:44%\"></i><i style=\"--h:66%\"></i><i style=\"--h:38%\"></i><i style=\"--h:82%\"></i></div>\n                </div>\n                <p class=\"dpd-doc-cap\">Call</p>\n              </article>\n            </div>\n          </div>\n          <div class=\"dpd-lane dpd-lane--capital\">\n            <div class=\"dpd-lane-h\"><div class=\"dpd-avatar\" aria-hidden=\"true\"></div><p class=\"dpd-lane-name\">Capital Partner</p></div>\n            <div class=\"dpd-arts\">\n              <article class=\"dpd-doc dpd-doc--termsheet\" aria-label=\"Term sheet\">\n                <div class=\"dpd-doc-stack\" aria-hidden=\"true\"></div>\n                <div class=\"dpd-doc-body dpd-legal\">\n                  <div class=\"dpd-legal-title\"></div>\n                  <div class=\"dpd-legal-clause\"></div>\n                  <div class=\"dpd-legal-clause short\"></div>\n                  <div class=\"dpd-legal-clause\"></div>\n                </div>\n                <p class=\"dpd-doc-cap\">Term Sheet</p>\n              </article>\n              <article class=\"dpd-doc dpd-doc--sheet\" aria-label=\"Spreadsheet fragment\">\n                <div class=\"dpd-doc-stack\" aria-hidden=\"true\"></div>\n                <div class=\"dpd-doc-body dpd-sheet\">\n                  <div class=\"dpd-sheet-grid\">\n                    <span class=\"h\"></span><span class=\"h\"></span><span class=\"h\"></span>\n                    <span></span><span class=\"warn\"></span><span></span>\n                    <span class=\"empty\"></span><span></span><span class=\"warn\"></span>\n                  </div>\n                </div>\n                <p class=\"dpd-doc-cap\">Sheet</p>\n              </article>\n              <article class=\"dpd-doc dpd-doc--follow\" aria-label=\"Follow-up request\">\n                <div class=\"dpd-doc-body dpd-follow\">\n                  <span class=\"dpd-follow-badge\">?</span>\n                  <i></i><i></i>\n                </div>\n                <p class=\"dpd-doc-cap\">Follow-up</p>\n              </article>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"dpd-zone dpd-zone--3\" data-zone=\"3\" aria-label=\"Inconsistent comparison\">\n        <p class=\"dpd-zone-label\">Comparison</p>\n        <div class=\"dpd-compare\" role=\"table\" aria-label=\"Misaligned comparison across workstreams\">\n          <div class=\"dpd-compare-row dpd-compare-row--head\" role=\"row\">\n            <div class=\"dpd-th\" role=\"columnheader\"></div>\n            <div class=\"dpd-th\" role=\"columnheader\">Brand</div>\n            <div class=\"dpd-th\" role=\"columnheader\">Ops</div>\n            <div class=\"dpd-th\" role=\"columnheader\">Adv</div>\n            <div class=\"dpd-th\" role=\"columnheader\">Cap</div>\n          </div>\n          <div class=\"dpd-compare-row\" role=\"row\">\n       