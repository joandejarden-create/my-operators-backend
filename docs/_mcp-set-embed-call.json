troke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg></div>\n            <div class=\"dpd-st dpd-st--miss\" role=\"cell\" title=\"Missing\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M5 5l6 6M11 5l-6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg></div>\n          </div>\n          <div class=\"dpd-compare-row\" role=\"row\">\n            <div class=\"dpd-rl\" role=\"rowheader\">Timing</div>\n            <div class=\"dpd-st dpd-st--diff\" role=\"cell\" title=\"Different basis\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M4 5h8M4 11h8M5.5 3.5v9M10.5 3.5v9\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg></div>\n            <div class=\"dpd-st dpd-st--diff\" role=\"cell\" title=\"Different basis\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M4 5h8M4 11h8M5.5 3.5v9M10.5 3.5v9\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg></div>\n            <div class=\"dpd-st dpd-st--partial\" role=\"cell\" title=\"Partial\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"5\" stroke=\"currentColor\" stroke-width=\"1.7\" fill=\"none\" stroke-dasharray=\"10 7\"/></svg></div>\n            <div class=\"dpd-st dpd-st--ok\" role=\"cell\" title=\"Complete\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.2 8.2l3 3 6.4-6.6\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/></svg></div>\n          </div>\n          <div class=\"dpd-compare-row\" role=\"row\">\n            <div class=\"dpd-rl\" role=\"rowheader\">Gaps</div>\n            <div class=\"dpd-st dpd-st--miss\" role=\"cell\" title=\"Gaps\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M5 5l6 6M11 5l-6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg></div>\n            <div class=\"dpd-st dpd-st--miss\" role=\"cell\" title=\"Gaps\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M5 5l6 6M11 5l-