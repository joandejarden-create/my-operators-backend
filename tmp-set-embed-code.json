px 16px;border-radius:100px;font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--pl);margin-bottom:28px}\n.dc-v9 .puls{width:6px;height:6px;border-radius:50%;background:var(--gold)}\n.dc-v9 .h1wrap{display:flex;flex-wrap:wrap;justify-content:center;align-items:baseline;gap:.35em;margin:0 auto 20px}\n.dc-v9 .hstatic{font-weight:800;font-size:clamp(28px,4vw,48px);letter-spacing:-.035em;line-height:1.1}\n.dc-v9 .hrword{font-family:var(--serif);font-style:italic;font-weight:500;font-size:clamp(28px,4vw,48px);color:var(--gold);letter-spacing:-.02em}\n.dc-v9 .ghost{display:flex;flex-direction:column;gap:2px;margin:0 0 18px;opacity:.28;pointer-events:none}\n.dc-v9 .ghost span{font-family:var(--serif);font-style:italic;font-size:clamp(18px,2.4vw,28px);color:#8B90FF}\n.dc-v9 .hsub{max-width:720px;margin:0 auto 28px;font-size:17px;line-height:1.65;color:var(--se)}\n.dc-v9 .hctas{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:28px}\n.dc-v9 .bp2{display:inline-flex;align-items:center;justify-content:center;padding:12px 22px;border-radius:8px;background:var(--purple);color:#fff;font-weight:700;text-decoration:none}\n.dc-v9 .bs2{display:inline-flex;align-items:center;justify-content:center;padding:12px 22px;border-radius:8px;background:transparent;color:#fff;font-weight:600;text-decoration:none;border:1px solid rgba(255,255,255,.35)}\n.dc-v9 .email-capture{max-width:520px;margin:0 auto}\n.dc-v9 .ec-label{font-size:13px;color:var(--mu);margin:0 0 10px}\n.dc-v9 .ec-row{display:flex;gap:12px;align-items:center;justify-content:center;flex-wrap:wrap}\n.dc-v9 .ec-input{flex:1;min-width:220px;background:rgba(255,255,255,.04);border:1px solid var(--bo);border-radius:8px;padding:12px 14px;color:#fff;font:inherit}\n.dc-v9 .ec-link{color:var(--pl);font-weight:700;text-decoration:none;background:none;border:none;cursor:pointer;font:inherit}\n.dc-v9 .ec-note{font-size:12px;color:var(--mu);margin:10px 0 0}\n.dc-v9 #proofbar{border-top:1px solid var(--bo);border-bottom:1px solid var(--bo);padding:14px 24px;overflow:hidden}\n.dc-v9 .proofbar-in{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;font-size:13px;color:var(--se)}\n.dc-v9 #problem{padding:80px 48px}\n.dc-v9 .si{max-width:1120px;margin:0 auto}\n.dc-v9 .ey{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--pl);margin:0 0 14px}\n.dc-v9 .h2{font-size:clamp(28px,4vw,44px);font-weight:800;letter-spacing:-.03em;line-height:1.15;margin:0 0 18px}\n.dc-v9 .lead{font-size:17px;line-height:1.65;color:var(--se);max-width:640px;margin:0 0 36px}\n.dc-v9 .pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}\n.dc-v9 .pcol{background:rgba(255,255,255,.03);border:1px solid var(--bo);border-radius:12px;padding:24px}\n.dc-v9 .pwho{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--pl);margin-bottom:12px}\n.dc-v9 .ph{font-size:20px;font-weight:700;line-height:1.3;margin-bottom:12px}\n.dc-v9 .pb{font-size:15px;line-height:1.6;color:var(--se);margin-bottom:14px}\n.dc-v9 .pr{font-size:14px;line-height:1.5;color:var(--gold);font-weight:600}\n@media(max-width:900px){.dc-v9 .nl,.dc-v9 .nr{display:none}.dc-v9 .nmenu{display:block;background:none;border:none;color:#fff}.dc-v9 nav{padding:0 20px}.dc-v9 #hero,.dc-v9 #problem{padding-left:20px;padding-right:20px}.dc-v9 .pgrid{grid-template-columns:1fr}}\n</style>\n<nav>\n  <a href=\"https://www.dealality.com/\" class=\"logo\" aria-label=\"Dealality home\"><img src=\"https://cdn.prod.website-files.com/68108c29063eeb5d1bd7ae4a/69c166836c109719f94e055e_Dealality%20Logo%20(4)%20(1).png\" width=\"320\" height=\"127\" alt=\"Dealality\"></a>\n  <ul class=\"nl\">\n    <li><a href=\"#owners\">For Owners</a></li>\n    <li><a href=\"#brands\">For Brands &amp; Operators</a></li>\n    <li><a href=\"#partners\">For Partners</a></li>\n    <li><a href=\"#how\">How it Works</a></li>\n    <li><a href=\"#faq\">FAQs</a></li>\n    <li><a href=\"https://www.dealality.com/insights\">Insights</a></li>\n  </ul>\n  <div class=\"nr\"><a href=\"https://www.dealality.com/login\" class=\"nbg\">Sign In</a><a href=\"https://www.dealality.com/signup\" class=\"nbn\">Request Early Access</a></div>\n</nav>\n<section id=\"hero\">\n  <div class=\"hero-grid\">\n    <div class=\"hbadge\"><span class=\"puls\"></span>PRIVATE BETA · NOW OPEN</div>\n    <div class=\"ghost\" aria-hidden=\"true\"><span>hotel brand.</span><span>operator.</span><span>operating model.</span><span>growth opportunity.</span></div>\n    <div class=\"h1wrap\"><span class=\"hstatic\">Find the right</span><span class=\"hrword\">commercial fit.</span></div>\n    <p class=\"hsub\">Hotel brand and operator pitches were never built to be compared side by side. Dealality is the confidential platform for that work — research before outreach, criteria-based matching, standardized responses, and side-by-side term comparison in NDA-gated deal rooms, through to LOI on your timeline.</p>\n    <div class=\"hctas\"><a class=\"bp2\" href=\"https://www.dealality.com/signup\">Get Started →</a><a class=\"bs2\" href=\"#how\">Watch Overview</a></div>\n    <div class=\"email-capture\">\n      <p class=\"ec-label\">Or stay informed for beta updates</p>\n      <div class=\"ec-row\"><input class=\"ec-input\" type=\"email\" placeholder=\"Your email\" aria-label=\"Email\"><a class=\"ec-link\" href=\"https://www.dealality.com/signup\">Stay informed →</a></div>\n      <p class=\"ec-note\">No commitment — we'll reach out when your market opens.</p>\n    </div>\n  </div>\n</section>\n<div id=\"proofbar\"><div class=\"proofbar-in\"><span style=\"color:#D78E2C;font-weight:600\">Free to submit during private beta</span><span>·</span><span>Owner-initiated · NDA-gated deal rooms</span><span>·</span><span>Not a broker · Steps back at LOI</span><span>·</span><span>Research before outreach · Side-by-side comparison</span><span>·</span><span>Americas · Canada · Europe</span></div></div>\n<section id=\"problem\">\n  <div class=\"si\">\n    <p class=\"ey\">The Problem</p>\n    <h2 class=\"h2\">Most Owners Do Not Lack Options.<br>They Lack a Fair Way to Compare Them.</h2>\n    <p class=\"lead\">Selecting a brand or operator is one of the most consequential decisions an owner makes — yet most owners still evaluate pitches in email threads, slide decks, and calls that were never designed to be compared apples to apples.</p>\n    <div class=\"pgrid\">\n      <div class=\"pcol\" id=\"owners\"><div class=\"pwho\">For Owners</div><div class=\"ph\">Incomparable Pitches.<br>No Shared Framework.</div><div class=\"pb\">Owners meet multiple brands, repeat the same story, and receive proposals in different formats — with little visibility into fit, economics, or what “normal” looks like for their asset and market.</div><div class=\"pr\">Result: High-stakes decisions made on partial information and momentum, not clarity.</div></div>\n      <div class=\"pcol\" id=\"brands\"><div class=\"pwho\">For Brands &amp; Operators</div><div class=\"ph\">Misaligned Outreach.<br>Misqualified Leads.</div><div class=\"pb\">Development teams spend significant time responding to poorly scoped opportunities before the owner has done the work to be a serious counterparty.</div><div class=\"pr\">Result: Wasted pipeline capacity and conversations that should never have started.</div></div>\n      <div class=\"pcol\" id=\"partners\"><div class=\"pwho\">For Advisors &amp; Partners</div><div class=\"ph\">Looped in Late.<br>Limited Context.</div><div class=\"pb\">Lenders, attorneys, and consultants typically enter after key conversations have already taken place. Deal structure is partially set and fragmented information is spread across emails, PDFs, and informal discussions.</div><div class=\"pr\">Result: Advice on a process that’s already half-decided in someone else’s inbox.</div></div>\n    </div>\n  </div>\n</section>\n</div>"}}]}]}}]}