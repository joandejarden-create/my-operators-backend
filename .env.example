# Airtable (required for ingestion and API)
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_base_id

# VIC → Brand Explorer pilot — dedicated sandbox/test base (required before any sandbox patch)
# Duplicate production Brand Explorer base in Airtable UI; name must include Sandbox / Staging / Test.
# AIRTABLE_ENV=sandbox
# AIRTABLE_BASE_ID_SANDBOX=appXXXXXXXXXXXXXX
# BE_PILOT_SANDBOX_CONFIRMED=1
# Token must include the sandbox base. Prefer AIRTABLE_PAT (or AIRTABLE_SANDBOX_API_KEY) if
# AIRTABLE_API_KEY is production-only. Validate: npm run research-engine-v2:validate-airtable-sandbox
# Never set AIRTABLE_BASE_ID_SANDBOX equal to AIRTABLE_BASE_ID.

# GTM Owner Target List — separate internal base (CoStar licensed; never product-facing)
# Base name in Airtable: "Owner Targets Table"
#   node scripts/audit-gtm-owner-target-base.mjs
#   node scripts/ensure-gtm-owner-target-base.mjs --apply
#   node scripts/sync-gtm-owner-target-rollups.mjs --apply
# AIRTABLE_GTM_BASE_ID=appKZuK006BWIVjNW
# Uses AIRTABLE_PAT if main API key is not scoped to the GTM base (or set AIRTABLE_GTM_API_KEY)
# ChatGPT Custom GPT → GTM Airtable wrapper (docs/dealality-airtable-chatgpt-openapi.yaml)
# DEALALITY_AIRTABLE_CHATGPT_SECRET=generate_a_long_random_secret
# AIRTABLE_TOKEN=pat_...  # data.records:read/write + schema.bases:read for ChatGPT wrapper
# AIRTABLE_GTM_PROPERTIES_TABLE=Properties
# AIRTABLE_GTM_OWNER_TARGETS_TABLE=Owner Targets
# AIRTABLE_GTM_PILOT_TARGET_LIST_TABLE=Pilot Target List
# AIRTABLE_GTM_COMPANIES_TABLE=Companies
# Acquisition Intelligence (LinkedIn Connections CSV — internal/admin)
#   node scripts/ensure-acquisition-intelligence-schema.mjs --apply
#   /internal/acquisition-intelligence.html
# AIRTABLE_GTM_ACQUISITION_RELATIONSHIPS_TABLE=Acquisition Network Relationships
# AIRTABLE_GTM_ACQUISITION_IMPORT_BATCHES_TABLE=Acquisition Import Batches

# Module 1: NDA + Deal Room (table names must match Airtable exactly)
AIRTABLE_TABLE_DEALS=Deals
# Contact & Uploads Tab 13: generic pilot uploads write to this attachment column (default: Pro Forma or Financials)
# AIRTABLE_CU_ATTACHMENT_FIELD=Pro Forma or Financials
# Comma-separated attachment columns to aggregate on read (default: Pro Forma or Financials only)
# AIRTABLE_CU_ATTACHMENT_FIELDS=Pro Forma or Financials
AIRTABLE_TABLE_BRAND_DEAL_REQUESTS=Brand Deal Requests
# Phase 2: Operator Deal Requests (My Operator Deals) — table must exist in Airtable before writes
AIRTABLE_TABLE_OPERATOR_DEAL_REQUESTS=Operator Deal Requests
# /utils/me operator scope (Users → Operator Setup - Master → company_name)
AIRTABLE_ME_USERS_OPERATOR_SETUP_LINK=Operator Setup - Master
AIRTABLE_OPERATOR_SETUP_MASTER_TABLE=Operator Setup - Master
AIRTABLE_OPERATOR_COMPANY_NAME_FIELD=company_name
AIRTABLE_OPERATOR_SETUP_SUBMISSION_STATUS_FIELD=submission_status
AIRTABLE_OPERATOR_SETUP_ACTIVE_STATUS_VALUES=Active
# Temporary demo: allow owner/brand accounts to preview My Operator Deals UI (default ON when NODE_ENV != production)
# OPERATOR_DEALS_DEMO_BYPASS_ROLE=true
# OPERATOR_DEALS_DEMO_COMPANY=GHL Hoteles (GHL Holding)
# Demo Dealality stakeholder companies (workspace switcher Owner/Brand/Operator)
# DEALALITY_DEMO_OWNER_COMPANY_ID=recr0XXnseXNlIlxk
# DEALALITY_DEMO_BRAND_COMPANY_ID=reciQEtqmxz6ZroVc
# DEALALITY_DEMO_OPERATOR_COMPANY_ID=recr0XXnseXNlIlxk
AIRTABLE_TABLE_DEAL_ACTIVITY_LOG=Deal Activity Log
AIRTABLE_TABLE_DEAL_ROOM_DOCUMENTS=Deal Room Documents

# Module 2: Proposal submission history (snapshot per submit)
AIRTABLE_TABLE_PROPOSAL_SUBMISSIONS=Proposal Submissions

# Schema patch (patch-nda-deal-room-schema.js) requires Personal Access Token with:
#   schema.bases:read
#   schema.bases:write
# Data read/write uses standard data.records scopes (same as other API calls).

# Market Alerts tables (must match Airtable)
AIRTABLE_TABLE_MARKET_ALERTS=MarketAlerts
AIRTABLE_TABLE_USER_STATUS=UserAlertStatus

# Market Alerts RSS auto-sync (optional)
# Manual: npm run market-alerts:rss:sync
# Option A — in-server scheduler (single instance; default off):
# MARKET_ALERTS_RSS_SYNC_ENABLED=true
# MARKET_ALERTS_RSS_SYNC_INTERVAL_MINUTES=240
# MARKET_ALERTS_RSS_SYNC_ON_STARTUP=true
# Option B — HTTP cron (Railway Cron, GitHub Actions, cron-job.org):
# MARKET_ALERTS_RSS_CRON_SECRET=generate_a_long_random_secret
# POST https://your-app.up.railway.app/api/cron/market-alerts-rss-sync
# Header: x-cron-secret: <same secret>
# MARKET_ALERTS_RSS_SYNC_LIMIT=100
# Enrich title-only RSS (e.g. Hotel Executive) from article meta description before Airtable write
# MARKET_ALERTS_RSS_ENRICH_SUMMARIES=true
# MARKET_ALERTS_SUMMARY_ENRICH_CONCURRENCY=4
# MARKET_ALERTS_SUMMARY_FETCH_TIMEOUT_MS=8000
# Backfill: npm run market-alerts:backfill-summaries

# Workspace KPI weekly snapshots (optional; falls back to data/brand-workspace-kpi-history.json)
# Create table "Workspace KPI Snapshots" with text fields: Scope Key, Persona, Week Key, Snapshot JSON; date Saved At
# AIRTABLE_TABLE_WORKSPACE_KPI_SNAPSHOTS=Workspace KPI Snapshots

# Ingestion tuning
LOOKBACK_HOURS=24
MAX_ITEMS=100
MIN_PER_CATEGORY=8
MAX_LOOKBACK_HOURS=168

# Set to false to write to Airtable; true to log only (no writes)
DRY_RUN=false

# When GDELT fails: true = use RSS fallback then synthetic last resort
FALLBACK_SEED=false
# RSS fallback (optional; default = curated hospitality feeds)
# RSS_FEEDS=https://example.com/feed1,https://example.com/feed2
RSS_MAX_PER_FEED=25
RSS_TOTAL_TARGET=250
MAX_ARTICLE_AGE_DAYS=30
BOOTSTRAP=false

# Franchise Application (table must have Deal + Form Data)
# AIRTABLE_TABLE_FRANCHISE_APPLICATIONS=Franchise Applications
# AIRTABLE_FRANCHISE_APPLICATION_DEAL_FIELD=Deal
# AIRTABLE_FRANCHISE_APPLICATION_FORM_DATA_FIELD=Form Data

# My Deals fast mode (defaults in code; override here if needed)
MY_DEALS_USE_BATCHED_LINKED_FETCHES=1
MY_DEALS_USE_PARALLEL_BATCHED_LINKED_FETCHES=1
MY_DEALS_BATCH_FETCH_CHUNK_SIZE=12
MY_DEALS_BATCH_FETCH_DELAY_MS=50
MY_DEALS_PHASE_GAP_MS=100
# Optional pacing (ms). Raise serial interval (e.g. 1200) if Airtable returns 429 / blank fields on heavy bases.
# MY_DEALS_AIRTABLE_SERIAL_INTERVAL_MS=750
# MY_DEALS_COLD_START_DELAY_MS=500
# MY_DEALS_MIN_GAP_MS=1500
# Defer BDR + Target List hydration to POST /api/my-deals/initial-matched-support (faster first paint). Set 0 to bundle on GET ?view=initial.
# MY_DEALS_DEFER_INITIAL_MATCHED_SUPPORT=1

# Brand Explorer / Brand Library API caches (seconds; defaults: list 120s, detail 300s)
# BRAND_LIBRARY_LIST_CACHE_TTL_MS=120000
# BRAND_LIBRARY_DETAIL_CACHE_TTL_MS=300000
# DISABLE_BRAND_LIBRARY_LIST_CACHE=1
# DISABLE_BRAND_LIBRARY_DETAIL_CACHE=1

# Operator Fit Engine v2 (beside legacy OAS; default OFF)
# 0/false = legacy OAS only (production default)
# 1/true = enable owner-facing Top-5 Operator Alignment API + UI
OPERATOR_FIT_ENGINE_V2=0
# 1/true = allow shadow/diagnostic evaluation without owner-facing enablement
# OPERATOR_FIT_ENGINE_V2_SHADOW=0
# Targeted differentiation refinement (v2.1) — internal/shadow only; default OFF
OPERATOR_FIT_DIFFERENTIATION_V21=0
# Internal pilot only (admin + deal allowlist). Does NOT enable owner My Deals.
OPERATOR_FIT_INTERNAL_PILOT=0
# Comma-separated pilot deal IDs (e.g. pilot_deal_a,pilot_conversion_mexico)
# OPERATOR_FIT_PILOT_DEAL_ALLOWLIST=
# Required when NODE_ENV=production to allow internal pilot APIs
# OPERATOR_FIT_INTERNAL_PILOT_ALLOW_PRODUCTION=0

# Third-party operator Service Offerings: legacy per-option checkbox columns (off by default; set 1 if your base still uses them)
# OPERATOR_SERVICE_GRANULAR_CHECKBOX_WRITES=0

# Operator Setup new-base writer feature flags
# 0/false = keep legacy writer as primary
OPERATOR_SETUP_USE_NEW_BASE_WRITER=0
# 1/true = run new-base writer in parallel while legacy path remains source of truth
OPERATOR_SETUP_NEW_BASE_SHADOW_WRITE=0
# 1/true = if new-base primary writer fails, continue with legacy writer path
OPERATOR_SETUP_NEW_BASE_FAIL_OPEN=0

# Operator Explorer: when activeOnly=1, also hide obvious QA / E2E test rows from the list (optional)
# OPERATOR_EXPLORER_HIDE_TEST_RECORDS=1

# Brand Explorer — per-user saved brands (Airtable; syncs across devices when user is identified)
# Create table: node scripts/ensure-brand-explorer-favorites-table.mjs
# BRAND_EXPLORER_FAVORITES_TABLE_ID=tblXXXXXXXX

# Brand Explorer — Factory Preview Mode (local/internal only; does NOT change Brand Status or Active universe)
# Preview URL: /brand-explorer-combined.html?brandId=rec…&beInternalPreview=1&factoryPreview=1
# BRAND_EXPLORER_FACTORY_PREVIEW=1
# BRAND_EXPLORER_FACTORY_PREVIEW_SLUGS=tapestry-collection-by-hilton,dazzler-by-wyndham,trademark-collection-by-wyndham
# Audit: npm run brand-explorer-factory-preview-mode -- --dry-run
# Test:  npm run test:brand-explorer-factory-preview-mode

# Commercial Acceptances — Terms + Commercial Terms Schedule acceptance tracking (Deal Capture MVP)
# Create/ensure: node scripts/ensure-commercial-acceptances-table.mjs [--apply]
# COMMERCIAL_ACCEPTANCES_TABLE_ID=tblznOWoTE0vF1dVG

# Operator Explorer — per-user saved operators (links Operator Setup - Master; separate junction table)
# Create table: node scripts/ensure-operator-explorer-favorites-table.mjs
# OPERATOR_EXPLORER_FAVORITES_TABLE_ID=tblXXXXXXXX
# OPERATOR_EXPLORER_USER_FAVORITES_LINK_FIELD=Operator Explorer Favorites

# Capital Explorer — favorites stored in Capital Setup - Deal Capital Provider List
# (List Status = Saved, no Related Deal). Optional override if table id differs:
# CAPITAL_DEAL_PROVIDER_LIST_TABLE_ID=tblXXXXXXXX
# Add User_ID link field: node scripts/ensure-capital-setup-schema.mjs --apply

