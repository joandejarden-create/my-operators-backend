# Footprint tab: roll up Hotel Census into brand detail (requires AIRTABLE_BASE_ID_ALT + brand alias mapping)
# BRAND_EXPLORER_CENSUS_METRICS=1

# Market Demand Intelligence — tables on Deal Capture Platform (not Deal Capture MVP)
# AIRTABLE_BASE_ID_ALT=your_platform_base_id
# Read-only PAT for brand-fit-analyzer reads against ALT base (api/brand-fit-analyzer.js).
# Must have data.records:read on AIRTABLE_BASE_ID_ALT; do not reuse production write token unless scoped.
# AIRTABLE_API_KEY_READONLY=pat_...
# Optional override if Market Demand uses a dedicated base:
# AIRTABLE_MARKET_DEMAND_BASE_ID=your_platform_base_id
# Cross-base deal link field on Platform tables (default: Deal Record ID):
# AIRTABLE_MARKET_DEMAND_DEAL_RECORD_ID_FIELD=Deal Record ID
# Optional mirror on MVP Deals table (default: Linked Market Record ID):
# AIRTABLE_DEALS_LINKED_MARKET_RECORD_ID_FIELD=Linked Market Record ID
# Schema: node scripts/ensure-market-demand-schema.mjs --apply
# Seed:   node scripts/seed-demand-categories.mjs && node scripts/seed-market-demand-sample.mjs [dealId]

# Travel Infrastructure / Radar Map Points (Deal Capture Platform — AIRTABLE_BASE_ID_ALT)
# Table: Travel Infrastructure Data (legacy API alias: Travel Infrastructure data)
# AIRTABLE_TABLE_TRAVEL_INFRASTRUCTURE=Travel Infrastructure Data
# Schema: node scripts/ensure-travel-infrastructure-schema.mjs --apply
# Types:  node scripts/seed-travel-infrastructure-types.mjs
# API:    GET /api/travel-infrastructure  |  GET /api/radar-map-points/travel-infrastructure
# Brand library list cache (ms, default 120000). Set DISABLE_BRAND_LIBRARY_LIST_CACHE=1 to bypass.
# BRAND_LIBRARY_LIST_CACHE_TTL_MS=120000
# USER_FAVORITES_TABLE_ID=  # Partner Directory favorites (separate table)
# USERS_TABLE_ID=tbl6shiyz2wdUqE5F
# LEGACY_USER_MANAGEMENT_TABLE_ID=tblQEpYKf2aYNKKjw  # migration scripts only
# USER_MANAGEMENT_TABLE_ID=  # deprecated — use USERS_TABLE_ID
# Memberstack (sign-in → verify JWT server-side; never commit real keys)
# Required for local app shell (/app) and protected APIs (My Deals, /api/me).
# Live app (dealality.com) — same MEMBERSTACK_APP_ID on local + Railway:
# MEMBERSTACK_APP_ID=app_cm9yhctsc00vn0wuz3ytk2jkt
# MEMBERSTACK_SECRET_KEY=sk_xxxxxxxx
# Localhost cannot be a Live domain in Memberstack; local login uses Test Mode (mem_sb_…).
# Set test key so /api/me resolves sandbox JWTs by email without changing Airtable Live ids:
# MEMBERSTACK_TEST_SECRET_KEY=sk_sb_xxxxxxxx
# MEMBERSTACK_LIVE_SECRET_KEY=sk_xxxxxxxx
# MEMBERSTACK_BASE_URL=https://admin.memberstack.com
# AIRTABLE_ME_USERS_MEMBERSTACK_FIELDS=flddTfp7oLdcPwBIC,fldEgbHu5MvfyrxgE
# Legacy Airtable names (both mirror Memberstack member id until rename):
#   Unique Webflow ID (flddTfp7oLdcPwBIC) = Memberstack Member ID (primary)
#   Slug (fldEgbHu5MvfyrxgE) = Memberstack Member ID mirror — must match primary
# AIRTABLE_USERS_MEMBERSTACK_ID_FIELD=Unique Webflow ID
# AIRTABLE_USERS_SLUG_FIELD_NAME=Slug
# AIRTABLE_USERS_SLUG_FIELD=fldEgbHu5MvfyrxgE

# Dealality user fields on Airtable Users (names must match your base)
# AIRTABLE_USERS_ROLE_FIELDS=Platform Role,User Type,Role
# AIRTABLE_USERS_STATUS_FIELDS=Status,Account Status
# SIGNUP_AIRTABLE_STATUS_FIELD=Account Status
# SIGNUP_AIRTABLE_PENDING_STATUS=Pending
# SIGNUP_AIRTABLE_APPROVED_STATUS=Active
# AIRTABLE_USERS_COMPANY_LINK_FIELD=Company Profile
# AIRTABLE_DEALS_COMPANY_LINK_FIELD=Company Profile
# Workspace permissions (Company Profile only — no Workspace Access field on Users in base appvtnDurnMSjINP6):
# AIRTABLE_COMPANY_WORKSPACE_ACCESS_FIELD=Workspace Access
# AIRTABLE_COMPANY_WORKSPACE_ACCESS_FIELD_ID=fldhZqzi0LskI0MpK
# Legacy resolve-user merge fallback only — not used for pilot provisioning checks:
# AIRTABLE_USERS_WORKSPACE_ACCESS_FIELD=Workspace Access
# AIRTABLE_USERS_INACTIVE_STATUS_VALUES=inactive,disabled,suspended,archived
# Never store mem_sb_ Test Mode ids on production Users rows — live pilots use mem_ only.

# Owner Pilot Runbook uses dealality.isAdmin from /api/me (Workspace Access Admin on Company Profile).
# Optional legacy alias — isInternalRunbookAdmin on /api/me mirrors isAdmin.
# MY_DEALS_ALLOW_BRAND_OPERATOR=0

# Marketing — live app iframe embeds on Webflow (CALA demo deal for deal workflow frames)
# MARKETING_DEMO_DEAL_ID=recqGVET08a8faagy
# MARKETING_DEMO_DEAL_NAME=Mérida Centro Select-Service
# PUBLIC_URL=https://my-operators-backend.up.railway.app
# Admin alerts for new signup + Request a Demo (Notify only) + Opportunity Review
# SIGNUP_NOTIFY_EMAIL=hello@aohospitalityadvisors.com
# SUPPORT_EMAIL=hello@aohospitalityadvisors.com
# Landing hero "Stay informed" → Users table (User Type single-select must include this value)
# MARKETING_NOTIFY_USER_TYPE=Notify only
# MARKETING_NOTIFY_STATUS=Pending
# Landing page event log (append-only). Set 0 to disable.
# LANDING_ANALYTICS_ENABLED=1
# Private bookmark for /landing-analytics-report — no Memberstack sign-in when key is in URL.
# LANDING_ANALYTICS_REPORT_KEY=choose-a-long-random-secret
# Persistent storage on Railway: mount a Volume at /data, then:
# LANDING_ANALYTICS_LOG_FILE=/data/marketing-landing-events.jsonl
# Or: LANDING_ANALYTICS_LOG_DIR=/data
# Same Microsoft Clarity project id as Webflow (Settings → Setup). Enables iframe custom events.
# CLARITY_PROJECT_ID=your-clarity-project-id

# Census address-first geocoding (production-census-address-geocode-resolver)
# GEOCODING_PROVIDER=mapbox|google|none  (default auto: mapbox if token, else google if key, else none)
GEOCODING_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
# Set to 1 only when Mapbox account permits permanent storage of geocodes in Airtable
MAPBOX_PERMANENT_GEOCODING=0
# Autopilot coordinate_completion — required with Mapbox Permanent for Census lat/long writes
CENSUS_COORDINATE_COMPLETION_ENABLED=0
MAX_GEOCODE_REQUESTS_PER_RUN=250
# Founder-approved Mapbox Permanent wave (Hotel Property Census stored coords)
# MAX_MAPBOX_PERMANENT_REQUESTS=10000
# MAX_MAPBOX_PERMANENT_COST_USD=55
# CENSUS_MASTER_MAPBOX_STRUCTURED_ADDRESS_PATHWAY=1
# Optional USD per 1k permanent geocode requests (default estimate 5 when unset)
# MAPBOX_PERMANENT_GEOCODING_COST_PER_1000=5
# Set to 1 only after founder/legal review that Google Geocoding storage/display is permitted
GOOGLE_GEOCODE_STORAGE_TERMS_REVIEWED=0

# Google Maps / Places — pre-import verification only (not stored in Airtable)
# Prefer GOOGLE_PLACES_API_KEY when both are set.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_VERIFY_MAX_REQUESTS_PER_RUN=150
GOOGLE_PLACES_VERIFY_DELAY_MS=200
GOOGLE_PLACES_VERIFY_MAX_RESULTS=5
GOOGLE_PLACES_VERIFY_CACHE_ENABLED=true

# HBX / Hotelbeds Content API (smoke + future Census discovery lane)
