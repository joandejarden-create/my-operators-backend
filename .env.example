# Airtable (required for ingestion and API)
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_base_id

# GTM Owner Target List — separate internal base (CoStar licensed; never product-facing)
# Base name in Airtable: "Owner Targets Table"
#   node scripts/audit-gtm-owner-target-base.mjs
#   node scripts/ensure-gtm-owner-target-base.mjs --apply
#   node scripts/sync-gtm-owner-target-rollups.mjs --apply
# AIRTABLE_GTM_BASE_ID=appKZuK006BWIVjNW
# Uses AIRTABLE_PAT if main API key is not scoped to the GTM base (or set AIRTABLE_GTM_API_KEY)
# ChatGPT Custom GPT → GTM Airtable wrapper (docs/dealality-airtable-chatgpt-openapi.yaml)
# DEALALITY_AIRTABLE_CHATGPT_SECRET=generate_a_long_random_secret
# AIRTABLE_TOKEN=pat_...  # data.records:read/write + schema.bases:read for ChatGPT wrapper
# AIRTABLE_GTM_PROPERTIES_TABLE=Properties
# AIRTABLE_GTM_OWNER_TARGETS_TABLE=Owner Targets
# AIRTABLE_GTM_PILOT_TARGET_LIST_TABLE=Pilot Target List
# AIRTABLE_GTM_COMPANIES_TABLE=Companies

# Module 1: NDA + Deal Room (table names must match Airtable exactly)
AIRTABLE_TABLE_DEALS=Deals
# Contact & Uploads Tab 13: generic pilot uploads write to this attachment column (default: Pro Forma or Financials)
# AIRTABLE_CU_ATTACHMENT_FIELD=Pro Forma or Financials
# Comma-separated attachment columns to aggregate on read (default: Pro Forma or Financials only)
# AIRTABLE_CU_ATTACHMENT_FIELDS=Pro Forma or Financials
AIRTABLE_TABLE_BRAND_DEAL_REQUESTS=Brand Deal Requests
# Phase 2: Operator Deal Requests (My Operator Deals) — table must exist in Airtable before writes
AIRTABLE_TABLE_OPERATOR_DEAL_REQUESTS=Operator Deal Requests
# /utils/me operator scope (Users → Operator Setup - Master → company_name)
AIRTABLE_ME_USERS_OPERATOR_SETUP_LINK=Operator Setup - Master
AIRTABLE_OPERATOR_SETUP_MASTER_TABLE=Operator Setup - Master
AIRTABLE_OPERATOR_COMPANY_NAME_FIELD=company_name
AIRTABLE_OPERATOR_SETUP_SUBMISSION_STATUS_FIELD=submission_status
AIRTABLE_OPERATOR_SETUP_ACTIVE_STATUS_VALUES=Active
# Temporary demo: allow owner/brand accounts to preview My Operator Deals UI (default ON when NODE_ENV != production)
# OPERATOR_DEALS_DEMO_BYPASS_ROLE=true
# OPERATOR_DEALS_DEMO_COMPANY=GHL Hoteles (GHL Holding)
AIRTABLE_TABLE_DEAL_ACTIVITY_LOG=Deal Activity Log
AIRTABLE_TABLE_DEAL_ROOM_DOCUMENTS=Deal Room Documents

# Module 2: Proposal submission history (snapshot per submit)
AIRTABLE_TABLE_PROPOSAL_SUBMISSIONS=Proposal Submissions

# Schema patch (patch-nda-deal-room-schema.js) requires Personal Access Token with:
#   schema.bases:read
#   schema.bases:write
# Data read/write uses standard data.records scopes (same as other API calls).

# Market Alerts tables (must match Airtable)
AIRTABLE_TABLE_MARKET_ALERTS=MarketAlerts
AIRTABLE_TABLE_USER_STATUS=UserAlertStatus

# Market Alerts RSS auto-sync (optional)
# Manual: npm run market-alerts:rss:sync
# Option A — in-server scheduler (single instance; default off):
# MARKET_ALERTS_RSS_SYNC_ENABLED=true
# MARKET_ALERTS_RSS_SYNC_INTERVAL_MINUTES=10080
# MARKET_ALERTS_RSS_SYNC_ON_STARTUP=true
# Option B — HTTP cron (Railway Cron, GitHub Actions, cron-job.org):
# MARKET_ALERTS_RSS_CRON_SECRET=generate_a_long_random_secret
# POST https://your-app.up.railway.app/api/cron/market-alerts-rss-sync
# Header: x-cron-secret: <same secret>
# MARKET_ALERTS_RSS_SYNC_LIMIT=100
# Enrich title-only RSS (e.g. Hotel Executive) from article meta description before Airtable write
# MARKET_ALERTS_RSS_ENRICH_SUMMARIES=true
# MARKET_ALERTS_SUMMARY_ENRICH_CONCURRENCY=4
# MARKET_ALERTS_SUMMARY_FETCH_TIMEOUT_MS=8000

# Early Signal production discovery (V1.2.1) — opt-in; weekly cadence independent of RSS sync
# MARKET_ALERTS_EARLY_SIGNALS_ENABLED=true
# MARKET_ALERTS_EARLY_SIGNALS_INTERVAL_MINUTES=10080
# MARKET_ALERTS_EARLY_SIGNALS_STATE_PATH=data/market-alerts-early-signals-schedule-state.json
# Railway volume example: /data/market-alerts-early-signals-schedule-state.json
# MARKET_ALERTS_RSS_SCHEDULE_STATE_PATH=data/market-alerts-rss-schedule-state.json
# Railway volume example: /data/market-alerts-rss-schedule-state.json
# MARKET_ALERTS_EARLY_SIGNALS_WHEN=14d
# MARKET_ALERTS_EARLY_SIGNALS_MAX_AGE_DAYS=14
# MARKET_ALERTS_EARLY_SIGNALS_PER_QUERY=25
# MARKET_ALERTS_EARLY_SIGNALS_LIMIT=50
# Backfill: npm run market-alerts:backfill-summaries
# Actionable intelligence (same MarketAlerts row):
# npm run market-alerts:intelligence:ensure -- --dry-run
# npm run market-alerts:intelligence:backfill -- --dry-run --limit 100
# npm run market-alerts:intelligence:audit
# npm run test:market-alerts-intelligence

# Workspace KPI weekly snapshots (optional; falls back to data/brand-workspace-kpi-history.json)
# Create table "Workspace KPI Snapshots" with text fields: Scope Key, Persona, Week Key, Snapshot JSON; date Saved At
# AIRTABLE_TABLE_WORKSPACE_KPI_SNAPSHOTS=Workspace KPI Snapshots

# Ingestion tuning
LOOKBACK_HOURS=24
MAX_ITEMS=100
MIN_PER_CATEGORY=8
MAX_LOOKBACK_HOURS=168

# Set to false to write to Airtable; true to log only (no writes)
DRY_RUN=false

# When GDELT fails: true = use RSS fallback then synthetic last resort
FALLBACK_SEED=false
# RSS fallback (optional; default = curated hospitality feeds)
# RSS_FEEDS=https://example.com/feed1,https://example.com/feed2
RSS_MAX_PER_FEED=25
RSS_TOTAL_TARGET=250
MAX_ARTICLE_AGE_DAYS=30
BOOTSTRAP=false

# Franchise Application (table must have Deal + Form Data)
# AIRTABLE_TABLE_FRANCHISE_APPLICATIONS=Franchise Applications
# AIRTABLE_FRANCHISE_APPLICATION_DEAL_FIELD=Deal
# AIRTABLE_FRANCHISE_APPLICATION_FORM_DATA_FIELD=Form Data

# My Deals fast mode (defaults in code; override here if needed)
MY_DEALS_USE_BATCHED_LINKED_FETCHES=1
MY_DEALS_USE_PARALLEL_BATCHED_LINKED_FETCHES=1
MY_DEALS_BATCH_FETCH_CHUNK_SIZE=12
MY_DEALS_BATCH_FETCH_DELAY_MS=50
MY_DEALS_PHASE_GAP_MS=100
# Optional pacing (ms). Raise serial interval (e.g. 1200) if Airtable returns 429 / blank fields on heavy bases.
# MY_DEALS_AIRTABLE_SERIAL_INTERVAL_MS=750
# MY_DEALS_COLD_START_DELAY_MS=500
# MY_DEALS_MIN_GAP_MS=1500
# Defer BDR + Target List hydration to POST /api/my-deals/initial-matched-support (faster first paint). Set 0 to bundle on GET ?view=initial.
# MY_DEALS_DEFER_INITIAL_MATCHED_SUPPORT=1

# Brand Explorer / Brand Library API caches (seconds; defaults: list 120s, detail 300s)
# BRAND_LIBRARY_LIST_CACHE_TTL_MS=120000
# BRAND_LIBRARY_DETAIL_CACHE_TTL_MS=300000
# DISABLE_BRAND_LIBRARY_LIST_CACHE=1
# DISABLE_BRAND_LIBRARY_DETAIL_CACHE=1

# Third-party operator Service Offerings: legacy per-option checkbox columns (off by default; set 1 if your base still uses them)
# OPERATOR_SERVICE_GRANULAR_CHECKBOX_WRITES=0

# Operator Setup new-base writer feature flags
# 0/false = keep legacy writer as primary
OPERATOR_SETUP_USE_NEW_BASE_WRITER=0
# 1/true = run new-base writer in parallel while legacy path remains source of truth
OPERATOR_SETUP_NEW_BASE_SHADOW_WRITE=0
# 1/true = if new-base primary writer fails, continue with legacy writer path
OPERATOR_SETUP_NEW_BASE_FAIL_OPEN=0

# Operator Explorer: when activeOnly=1, also hide obvious QA / E2E test rows from the list (optional)
# OPERATOR_EXPLORER_HIDE_TEST_RECORDS=1

# Brand Explorer — per-user saved brands (Airtable; syncs across devices when user is identified)
# Create table: node scripts/ensure-brand-explorer-favorites-table.mjs
# BRAND_EXPLORER_FAVORITES_TABLE_ID=tblXXXXXXXX

# Brand Explorer — Factory Preview Mode (local/internal only; does NOT change Brand Status or Active universe)
# Preview URL: /brand-explorer-combined.html?brandId=rec…&beInternalPreview=1&factoryPreview=1
# BRAND_EXPLORER_FACTORY_PREVIEW=1
# BRAND_EXPLORER_FACTORY_PREVIEW_SLUGS=tapestry-collection-by-hilton,dazzler-by-wyndham,trademark-collection-by-wyndham
# Audit: npm run brand-explorer-factory-preview-mode -- --dry-run
# Test:  npm run test:brand-explorer-factory-preview-mode

# Commercial Acceptances — Terms + Commercial Terms Schedule acceptance tracking (Deal Capture MVP)
# Create/ensure: node scripts/ensure-commercial-acceptances-table.mjs [--apply]
# COMMERCIAL_ACCEPTANCES_TABLE_ID=tblznOWoTE0vF1dVG

# Operator Explorer — per-user saved operators (links Operator Setup - Master; separate junction table)
# Create table: node scripts/ensure-operator-explorer-favorites-table.mjs
# OPERATOR_EXPLORER_FAVORITES_TABLE_ID=tblXXXXXXXX
# OPERATOR_EXPLORER_USER_FAVORITES_LINK_FIELD=Operator Explorer Favorites

# Capital Explorer — favorites stored in Capital Setup - Deal Capital Provider List
# (List Status = Saved, no Related Deal). Optional override if table id differs:
# CAPITAL_DEAL_PROVIDER_LIST_TABLE_ID=tblXXXXXXXX
# Add User_ID link field: node scripts/ensure-capital-setup-schema.mjs --apply

# Reference files: G:\My Drive\Dealality™\Platform Design & Build\Brand Reference Material\{Company}\
# PARTNER_REFERENCE_ROOT=G:\My Drive\Dealality™\Platform Design & Build\Brand Reference Material
# OPERATOR_REFERENCE_ROOT=G:\My Drive\Dealality™\Platform Design & Build\Operator Reference Material
# PARTNER_INTELLIGENCE_SOURCE_TABLE=Partner Intelligence - Source Library
# PARTNER_INTELLIGENCE_SOURCE_TABLE_ID=tbl8iR7AtkUe0uctp
# PARTNER_INTELLIGENCE_FACTS_TABLE=Partner Intelligence - Extracted Facts
# PARTNER_INTELLIGENCE_FACTS_TABLE_ID=tbl4j5MAQtPL45BmF
# PARTNER_INTELLIGENCE_PUBLISHED_TABLE=Partner Intelligence - Published Explorer Fields
# PARTNER_INTELLIGENCE_PUBLISHED_TABLE_ID=tblGGYom9YM7d1OeS
# PARTNER_INTELLIGENCE_HELENA_TABLE=Partner Intelligence - Helena Outreach Intake
# PARTNER_INTELLIGENCE_HELENA_TABLE_ID=tblKh5kF6Bqj5LWFO
# PARTNER_INTELLIGENCE_EXTRACTION_ENABLED=0
# PARTNER_INTELLIGENCE_PUBLISH_ENABLED=0
# PARTNER_INTELLIGENCE_PUBLISH_OVERLAY=0
# PARTNER_INTELLIGENCE_LLM_EXTRACTION_ENABLED=0
# OPENAI_API_KEY=
# PARTNER_INTELLIGENCE_LLM_MODEL=gpt-4o-mini
# PARTNER_INTELLIGENCE_LLM_BATCH_SIZE=12
# COMMERCIAL_READINESS_LLM_ENRICHMENT_ENABLED=0
# COMMERCIAL_READINESS_LLM_MODEL=gpt-4o-mini
# COMMERCIAL_READINESS_URL_EXTRACTION_ENABLED=1
# COMMERCIAL_READINESS_URL_TIMEOUT_MS=8000
# COMMERCIAL_READINESS_URL_MAX_BYTES=350000
# PARTNER_INTELLIGENCE_ADMIN_ONLY=0
# PARTNER_INTELLIGENCE_ADMIN_ROLES=Platform Admin,Dealality Admin

# Footprint tab: roll up Hotel Census into brand detail (requires AIRTABLE_BASE_ID_ALT + brand alias mapping)
# BRAND_EXPLORER_CENSUS_METRICS=1

# Market Demand Intelligence — tables on Deal Capture Platform (not Deal Capture MVP)
# AIRTABLE_BASE_ID_ALT=your_platform_base_id
# Optional override if Market Demand uses a dedicated base:
# AIRTABLE_MARKET_DEMAND_BASE_ID=your_platform_base_id
# Cross-base deal link field on Platform tables (default: Deal Record ID):
# AIRTABLE_MARKET_DEMAND_DEAL_RECORD_ID_FIELD=Deal Record ID
# Optional mirror on MVP Deals table (default: Linked Market Record ID):
# AIRTABLE_DEALS_LINKED_MARKET_RECORD_ID_FIELD=Linked Market Record ID
# Schema: node scripts/ensure-market-demand-schema.mjs --apply
# Seed:   node scripts/seed-demand-categories.mjs && node scripts/seed-market-demand-sample.mjs [dealId]

# Travel Infrastructure / Radar Map Points (Deal Capture Platform — AIRTABLE_BASE_ID_ALT)
# Table: Travel Infrastructure Data (legacy API alias: Travel Infrastructure data)
# AIRTABLE_TABLE_TRAVEL_INFRASTRUCTURE=Travel Infrastructure Data
# Schema: node scripts/ensure-travel-infrastructure-schema.mjs --apply
# Types:  node scripts/seed-travel-infrastructure-types.mjs
# API:    GET /api/travel-infrastructure  |  GET /api/radar-map-points/travel-infrastructure
# Brand library list cache (ms, default 120000). Set DISABLE_BRAND_LIBRARY_LIST_CACHE=1 to bypass.
# BRAND_LIBRARY_LIST_CACHE_TTL_MS=120000
# USER_FAVORITES_TABLE_ID=  # Partner Directory favorites (separate table)
# USERS_TABLE_ID=tbl6shiyz2wdUqE5F
# LEGACY_USER_MANAGEMENT_TABLE_ID=tblQEpYKf2aYNKKjw  # migration scripts only
# USER_MANAGEMENT_TABLE_ID=  # deprecated — use USERS_TABLE_ID
# Memberstack (sign-in → verify JWT server-side; never commit real keys)
# Required for local app shell (/app) and protected APIs (My Deals, /api/me).
# Live app (dealality.com) — same MEMBERSTACK_APP_ID on local + Railway:
# MEMBERSTACK_APP_ID=app_cm9yhctsc00vn0wuz3ytk2jkt
# MEMBERSTACK_SECRET_KEY=sk_xxxxxxxx
# Localhost cannot be a Live domain in Memberstack; local login uses Test Mode (mem_sb_…).
# Set test key so /api/me resolves sandbox JWTs by email without changing Airtable Live ids:
# MEMBERSTACK_TEST_SECRET_KEY=sk_sb_xxxxxxxx
# MEMBERSTACK_LIVE_SECRET_KEY=sk_xxxxxxxx
# MEMBERSTACK_BASE_URL=https://admin.memberstack.com
# AIRTABLE_ME_USERS_MEMBERSTACK_FIELDS=flddTfp7oLdcPwBIC,fldEgbHu5MvfyrxgE
# Legacy Airtable names (both mirror Memberstack member id until rename):
#   Unique Webflow ID (flddTfp7oLdcPwBIC) = Memberstack Member ID (primary)
#   Slug (fldEgbHu5MvfyrxgE) = Memberstack Member ID mirror — must match primary
# AIRTABLE_USERS_MEMBERSTACK_ID_FIELD=Unique Webflow ID
# AIRTABLE_USERS_SLUG_FIELD_NAME=Slug
# AIRTABLE_USERS_SLUG_FIELD=fldEgbHu5MvfyrxgE

# Dealality user fields on Airtable Users (names must match your base)
# AIRTABLE_USERS_ROLE_FIELDS=Platform Role,User Type,Role
# AIRTABLE_USERS_STATUS_FIELDS=Status,Account Status
# SIGNUP_AIRTABLE_STATUS_FIELD=Account Status
# SIGNUP_AIRTABLE_PENDING_STATUS=Pending
# SIGNUP_AIRTABLE_APPROVED_STATUS=Active
# AIRTABLE_USERS_COMPANY_LINK_FIELD=Company Profile
# AIRTABLE_DEALS_COMPANY_LINK_FIELD=Company Profile
# Workspace permissions (Company Profile only — no Workspace Access field on Users in base appvtnDurnMSjINP6):
# AIRTABLE_COMPANY_WORKSPACE_ACCESS_FIELD=Workspace Access
# AIRTABLE_COMPANY_WORKSPACE_ACCESS_FIELD_ID=fldhZqzi0LskI0MpK
# Legacy resolve-user merge fallback only — not used for pilot provisioning checks:
# AIRTABLE_USERS_WORKSPACE_ACCESS_FIELD=Workspace Access
# AIRTABLE_USERS_INACTIVE_STATUS_VALUES=inactive,disabled,suspended,archived
# Never store mem_sb_ Test Mode ids on production Users rows — live pilots use mem_ only.

# Owner Pilot Runbook uses dealality.isAdmin from /api/me (Workspace Access Admin on Company Profile).
# Optional legacy alias — isInternalRunbookAdmin on /api/me mirrors isAdmin.
# MY_DEALS_ALLOW_BRAND_OPERATOR=0

# Marketing — live app iframe embeds on Webflow (CALA demo deal for deal workflow frames)
# MARKETING_DEMO_DEAL_ID=recqGVET08a8faagy
# MARKETING_DEMO_DEAL_NAME=Mérida Centro Select-Service
# PUBLIC_URL=https://my-operators-backend.up.railway.app
# Landing hero "Stay informed" → Users table (User Type single-select must include this value)
# MARKETING_NOTIFY_USER_TYPE=Notify only
# MARKETING_NOTIFY_STATUS=Pending
# Landing page event log (append-only). Set 0 to disable.
# LANDING_ANALYTICS_ENABLED=1
# Private bookmark for /landing-analytics-report — no Memberstack sign-in when key is in URL.
# LANDING_ANALYTICS_REPORT_KEY=choose-a-long-random-secret
# Persistent storage on Railway: mount a Volume at /data, then:
# LANDING_ANALYTICS_LOG_FILE=/data/marketing-landing-events.jsonl
# Or: LANDING_ANALYTICS_LOG_DIR=/data
# Same Microsoft Clarity project id as Webflow (Settings → Setup). Enables iframe custom events.
# CLARITY_PROJECT_ID=your-clarity-project-id

# Google Maps / Places — pre-import verification only (not stored in Airtable)
# Prefer GOOGLE_PLACES_API_KEY when both are set.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_VERIFY_MAX_REQUESTS_PER_RUN=150
GOOGLE_PLACES_VERIFY_DELAY_MS=200
GOOGLE_PLACES_VERIFY_MAX_RESULTS=5
GOOGLE_PLACES_VERIFY_CACHE_ENABLED=true

