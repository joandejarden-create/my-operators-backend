# GIATA_MHG_USERNAME=
# GIATA_MHG_PASSWORD=

# Hotel Intelligence � Room Count Research Engine (read-only; no census writes)
# ROOM_COUNT_RESEARCH_USE_SERPAPI=1
# ROOM_COUNT_RESEARCH_MAX_SEARCHES=3
# ROOM_COUNT_RESEARCH_MAX_FETCHES=3

# AI Demand Positioning — dedicated Airtable base (published owner snapshots)
# Create base: ADP_BASE_CREATE_APPLY=true npm run adp:create-base -- --apply
# ADP_AIRTABLE_BASE_ID=appa2cE7FTRmIbB32
# ADP_AIRTABLE_PUBLISH_APPLY=true
# ADP_AIRTABLE_READ_LIVE=1
# Census link: text rec… in Census Record ID column (cross-base join to Hotel Property Census)
# Registry: fixtures/ai-demand-positioning/census-links-v1.json


# Local ADP owner-app only (optional). Requires X-Dealality-Owner-App: 1. Never set in production.
# DEV_AUTH_BYPASS_EMAIL=you@example.com
