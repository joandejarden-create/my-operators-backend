# Official directory discovery — Railway-safe timeouts / resume (worker service)
CENSUS_DISCOVERY_RAILWAY_SAFE_MODE=0
CENSUS_DISCOVERY_FETCH_TIMEOUT_MS=20000
CENSUS_DISCOVERY_SOURCE_TIMEOUT_MS=60000
CENSUS_DISCOVERY_COUNTRY_TIMEOUT_MS=90000
CENSUS_DISCOVERY_SKIP_ON_TIMEOUT=1
CENSUS_DISCOVERY_RESUME=1
CENSUS_DISCOVERY_FORCE_REFRESH=0
CENSUS_DISCOVERY_CONCURRENCY=2
CENSUS_DISCOVERY_MAX_RETRIES=1
CENSUS_DISCOVERY_RETRY_BACKOFF_MS=3000
ENABLE_MAPBOX_AFTER_VALIDATED_ADDRESS=0
ENABLE_MAPBOX_AFTER_MEDIUM_MATCH_HIGH_ADDRESS=0
ENABLE_SECONDARY_HOTEL_DATA_SOURCES=0
ENABLE_SECONDARY_ROOMS_SOURCES=0
ENABLE_SECONDARY_PHONE_SOURCES=0
ENABLE_HIGH_CONFIDENCE_INSERTS=0
DATAFORSEO_ENABLE_BUSINESS_LISTINGS=0
DATAFORSEO_MAX_MARKETS=9
DATAFORSEO_MAX_QUERIES_PER_MARKET=2
# DATAFORSEO_COST_CAP_USD=5
# DATAFORSEO_DELAY_MS=350
# DATAFORSEO_V2_CANDIDATES_PATH=reports/research-engine-v2/autopilot/.../per-record-candidates.json

# StayingAPI research API (server-side only — never expose to browser)
# STAYINGAPI_KEY=

# SerpApi research API (server-side only — never expose to browser)
# SERPAPI_KEY=


# Hotel Intelligence MCP � StayingAPI provider (default off; enable only for validation)
HOTEL_INTELLIGENCE_STAYINGAPI=0
# STAYINGAPI_HI_CREDIT_CEILING=120


# Hotel Intelligence MCP � SerpApi provider (default off; enable only for validation)
HOTEL_INTELLIGENCE_SERPAPI=0
# SERPAPI_HI_CREDIT_CEILING=500

# GIATA Drive Open Content (server-side only — never expose to browser)
# GIATA_DRIVE_API_KEY=
# GIATA_DRIVE_USERNAME=
# GIATA_DRIVE_PASSWORD=
# Hotel Intelligence MCP — GIATA Drive complementary provider (default off)
HOTEL_INTELLIGENCE_GIATA_DRIVE=0

# GIATA MultiCodes TEST / production (HTTP Basic: name|company)
