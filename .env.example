HBX_API_BASE_URL=https://api.test.hotelbeds.com
HBX_CONTENT_API_BASE_URL=https://api.test.hotelbeds.com/hotel-content-api/1.0
# Conservative Content API pacing (geography discovery). TEST has a small daily quota.
HBX_MIN_REQUEST_INTERVAL_MS=1200
HBX_MAX_REQUESTS_PER_RUN=800
HBX_MAX_RETRIES_ON_429=4
HBX_BATCH_DELAY_MS=1200
# Optional separate LIVE credentials (never send TEST key to LIVE host)
# HBX_API_KEY_LIVE=
# HBX_API_SECRET_LIVE=
