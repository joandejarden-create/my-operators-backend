  "playbooks": [
    {
      "playbook_id": "MX-PUBCO-01",
      "name": "Public hospitality company → annual report ownership",
      "description": "From a Mexican listed hotel company seed, locate IR/annual report and extract hotel ownership/control mentions.",
      "jurisdictions": ["Mexico"],
      "trigger_conditions": ["validated_public_company_seed", "hotel_name_or_alias_known"],
      "required_seeds": ["company_legal_or_ticker", "hotel_display_name"],
      "optional_seeds": ["former_hotel_names", "city", "rooms"],
      "preferred_source_classes": ["company_annual_reports", "securities_exchange_regulatory_filings", "investor_relations_documents"],
      "query_templates": [
        "{company} reporte anual {year}",
        "{ticker} BMV reporte anual hotel",
        "{company} {hotel} propiedad OR control OR participación",
        "once IR /investors/pdf/ path discovered → probe {ticker}_Reporte_anual_{year}.pdf"
      ],
      "document_search_terms": ["propiedad", "participación", "adquisición", "habitaciones", "apertura", "marca", "Inmobiliaria", "partes relacionadas"],
      "entity_resolution_requirements": ["city_or_market_match", "rooms_or_opening_year_when_available", "reject_adjacent_similar_name"],
      "extraction_targets": ["ownership_pct", "control_language", "subsidiary_names", "rooms", "opening_date"],
      "relationship_types_allowed": ["OWNED_BY", "CONTROLLED_BY", "OPERATED_BY"],
      "temporal_classifications": ["CURRENT", "FORMER", "UNKNOWN"],
      "negative_screens": ["OPERATOR_NOT_OWNER", "WRONG_PROPERTY", "ADJACENT_ASSET", "SOURCE_NOT_DECISIVE", "CROSS_PROPERTY_ENTITY_PROPAGATION_GUARD"],
      "confidence_rules": ["issuer_annual_report_plus_identity_match → HIGH", "management-only mention → OPERATED_BY only"],
      "stop_conditions": ["economic_owner_HIGH_and_propco_candidate_or_explicit_gap"],
      "escalation_conditions": ["annual_report_unavailable", "hotel_not_mentioned_after_alias_search"],
      "known_failure_modes": [
        "treating managed third-party hotels as owned",
        "SerpAPI returns quarterlies instead of annual report — mitigate via IR path filename expansion",
        "hotels operated by issuer but not named in ownership tables correctly abstain"
      ],
      "successful_examples": ["kgpv-gsf-annual-report-2025", "pilot-2.4d-A-01", "pilot-2.4d-A-34-fibrahotel-condesa"],
      "failed_examples": ["krystal-resort-pv-managed-as-owned"],
      "version": "1.2.0",
      "readiness": "READY_FOR_LIMITED_SCALE",
      "empirical_2_4d": { "triggered": 24, "resolved": 6, "partial": 4, "abstained": 14, "false_confident": 0, "median_cost_usd": 0.01 },
      "precision": 1.0,
      "recall": null
    },
    {
