{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dealality://schemas/gdi-full-e2e-v1",
  "title": "GDI_FULL_E2E_V1",
  "type": "object",
  "required": ["workflowId", "workflowVersion", "hotelId", "mode"],
  "properties": {
    "workflowId": { "const": "GDI_FULL_E2E_V1" },
    "workflowVersion": { "type": "string" },
    "hotelId": { "type": "string", "pattern": "^rec[a-zA-Z0-9]{14}$" },
    "mode": {
      "enum": ["new", "refresh", "validate", "repair", "status", "dry_run"]
    },
    "authorizePaidDiscovery": { "type": "boolean" },
    "authorizePublish": { "type": "boolean" },
    "budgetUsd": { "type": "number", "minimum": 0 },
    "authorizationRef": { "type": "string" },
    "resumeRun": { "type": ["string", "null"] }
  }
}
