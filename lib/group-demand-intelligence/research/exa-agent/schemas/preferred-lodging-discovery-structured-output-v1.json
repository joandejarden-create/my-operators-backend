{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gdi-exa-preferred-lodging-partnership-discovery-structured-output-v1",
  "title": "PreferredLodgingDiscoveryCandidatesV1",
  "description": "Preferred Lodging venue / referral partnership discovery. Use null/UNKNOWN for unsupported. Do not invent distances, partnership agreements, or room nights.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "candidates"],
  "properties": {
    "contractId": {
      "type": "string",
      "const": "gdi-exa-preferred-lodging-partnership-discovery-v1"
    },
    "researchDate": { "type": ["string", "null"] },
    "hotelId": { "type": ["string", "null"] },
    "hotelName": { "type": ["string", "null"] },
    "candidates": {
      "type": "array",
      "maxItems": 15,
      "items": { "$ref": "#/$defs/venueDiscoveryCandidate" }
    },
    "materialUncertainties": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string" }
    },
    "notesForDeepResearch": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "evidenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "url"],
      "properties": {
        "claim": { "type": "string" },
        "url": { "type": "string" },
        "publishedDate": { "type": ["string", "null"] },
        "factVsInference": {
          "type": ["string", "null"],
          "enum": ["source_established_fact", "inferred_demand", "assumption", "unknown", null]
        }
      }
    },
    "venueDiscoveryCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["venueName", "supportingSources"],
      "properties": {
        "venueName": { "type": "string" },
        "venueAddress": { "type": ["string", "null"] },
        "website": { "type": ["string", "null"] },
        "venueType": { "type": ["string", "null"] },
        "eventTypes": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "onsiteLodgingMention": { "type": ["string", "null"] },
        "onsiteLodgingStatus": {
          "type": ["string", "null"],
          "enum": [
            "NO_ONSITE_LODGING",
            "LIMITED_ONSITE_LODGING",
            "ONSITE_LODGING_AVAILABLE",
            "UNKNOWN",
            null
          ]
        },
        "preferredHotelLanguage": { "type": ["string", "null"] },
        "referralPathwayHypothesis": { "type": ["string", "null"] },
        "supportingSources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/evidenceClaim" }
        }
      }
    }
  }
}
