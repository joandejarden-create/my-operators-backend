{
  "version": "census-autopilot-mission-v2",
  "mode": "mission",
  "objective": "cala-census-completion-v1",
  "region": "CALA",
  "scope": "active-brand-setup",
  "strategy": "fastest-safe",
  "cleanup_existing_only": true,
  "skip_inserts": true,
  "max_passes_budget": 6,
  "max_passes_semantics": "per_phase_cap",
  "batch_size": 100,
  "write_target": {
    "base": "Deal Capture Platform",
    "table": "Hotel Property Census",
    "table_id": "tbl9aY5ijiuIzzWam"
  },
  "soft_targets": {
    "address_complete_min": 400,
    "lat_long_complete_min": 350,
    "phone_complete_min": 100,
    "rooms_complete_min": 100,
    "complete_census_v1_min": 100,
    "clean_core_min": 875
  },
  "founder_approval": "mission_cli_command",
  "per_phase_chatgpt_approval": false,
  "phases": [
    {
      "order": 1,
      "id": "phase_2_reconfirm_brand_core",
      "label": "Reconfirm Brand / Core Identity",
      "queues": [
        "brand_normalization",
        "core_identity_quality",
        "core_identity_source_lookup",
        "canonical_property_name_completion",
        "city_state_normalization"
      ],
      "require_clean_core": false,
      "read_only": false,
      "max_passes": 3,
      "allowed_fields": [
        "Property Name",
        "Canonical Property Name",
        "Current Brand",
        "Brand Family",
        "City",
        "State / Region",
        "Country",
        "Source URL",
        "Official Property URL",
        "Family / Source Family",
        "Source Type",
        "Source Confidence",
        "Identity Confidence",
        "Data Confidence Tier",
        "Production Use Status",
        "Human Review Required",
        "Public Display Review Status",
        "Radar Display Status",
        "Radar Display Reason",
        "Enrichment Status",
        "Enrichment Priority",
        "Last Reviewed Date"
      ]
    },
    {
      "order": 2,
      "id": "phase_3_clean_core_classification",
      "label": "Clean Core Classification",
      "queues": [
        "clean_core_classification"
      ],
      "require_clean_core": false,
      "read_only": true,
      "max_passes": 1,
      "allowed_fields": []
    },
    {
      "order": 3,
      "id": "phase_4_market_geography",
      "label": "Market Geography",
      "queues": [
        "market_geography_completion"
      ],
      "require_clean_core": false,
      "read_only": false,
      "max_passes": 2,
      "allowed_fields": [
        "Continent",
        "Sub-Continent",
        "Market",
        "Submarket",
        "Country",
        "City",
        "State / Region",
        "Enrichment Status",
        "Enrichment Priority",
        "Last Reviewed Date"
      ]
    },
    {
      "order": 4,
      "id": "phase_5_address",
      "label": "Address Completion (Clean Core)",
      "queues": [
        "address_confirmation"
      ],
      "require_clean_core": true,
      "read_only": false,
      "max_passes": 3,
      "allowed_fields": [
        "Address",
        "Address Confidence",
        "Address Source URL",
        "City",
        "State / Region",
        "Country",
        "Enrichment Status",
        "Enrichment Priority",
        "Last Reviewed Date"
      ]
    },
    {
      "order": 5,
      "id": "phase_6_coordinates",
      "label": "Coordinate Completion (Clean Core + High Address)",
      "queues": [
        "coordinate_completion"
      ],
      "require_clean_core": true,
      "read_only": false,
      "max_passes": 3,
      "allowed_fields": [
        "Latitude",
        "Longitude",
        "Coordinate Source Type",
        "Coordinate Confidence",
        "Geocode Provider",
        "Geocode Method",
        "Geocode Reviewed Date",
        "Radar Geography Status",
        "Radar Display Status",
        "Radar Display Reason",
        "Public Display Review Status",
        "Enrichment Status",
        "Enrichment Priority",
        "Last Reviewed Date"
      ]
    },
    {
      "order": 6,
      "id": "phase_7_phone",
      "label": "Phone Completion (Clean Core / official only)",
      "queues": [
        "phone_number_enrichment"
      ],
      "require_clean_core": true,
      "read_only": false,
      "max_passes": 2,
      "allowed_fields": [
        "Phone",
        "Enrichment Status",
        "Enrichment Priority",
        "Last Reviewed Date"
      ]
    },
    {
      "order": 7,
      "id": "phase_8_rooms",
      "label": "Rooms Completion (Clean Core / official only)",
      "queues": [
        "rooms_keys"
      ],
      "require_clean_core": true,
      "read_only": false,
      "max_passes": 2,
      "allowed_fields": [
        "Rooms / Keys",
        "Rooms Confidence",
        "Rooms Source URL",
        "Rooms Source Type",
        "Rooms Reviewed Date",
        "Rooms Notes",
        "Enrichment Status",
        "Enrichment Priority",
        "Last Reviewed Date"
      ]
    },
    {
      "order": 8,
      "id": "phase_9_final_readiness",
      "label": "Final Readiness Classification",
      "queues": [
        "clean_core_classification"
      ],
      "require_clean_core": false,
      "read_only": true,
      "max_passes": 1,
      "allowed_fields": []
    }
  ],
  "hard_stop_conditions": [
    "wrong_census_table",
    "protected_field",
    "brand_setup_write",
    "brand_explorer_write",
    "legacy_census_or_vic_write",
    "owner_operator_date_field",
    "systemic_duplicate_insert_risk",
    "repeated_airtable_write_failure",
    "schema_conflict"
  ],
  "soft_continue_conditions": [
    "unknown_city",
    "blank_canonical",
    "blocked_property_pages",
    "no_high_proposals_in_queue",
    "mapbox_not_eligible",
    "missing_phone_source",
    "missing_room_source",
    "steward_cases",
    "source_insufficient",
    "missing_address_source"
  ]
}