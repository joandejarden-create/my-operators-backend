{
  "schema": "gdi-full-e2e-workflow-template-v1",
  "contractVersion": "gdi-full-e2e-contract-v1.5",
  "stages": [
    {
      "id": 1,
      "name": "Hotel intelligence",
      "commandHint": "validate hotel config + HPC/ADP identity"
    },
    {
      "id": 2,
      "name": "Existing research reconciliation",
      "commandHint": "gdi:research-storage-reconciliation-v1 --dry-run"
    },
    {
      "id": 3,
      "name": "Discovery planning",
      "commandHint": "gdi:full-e2e --dry-run (plan only)"
    },
    {
      "id": 4,
      "name": "Demand discovery",
      "commandHint": "gdi:full-e2e with authorized budget"
    },
    {
      "id": "4a",
      "name": "Competitor-booked business discovery (CMI)",
      "mandatory": true,
      "commandHint": "CMI discovery coverage checklist + classifyCompetitiveMarketIntelligence; zero CMI requires documented coverage proof",
      "contract": "gdi-cmi-canonical-eligibility-contract-v1",
      "stageSpec": {
        "id": "competitor_booked_business_discovery",
        "name": "Competitor-booked business discovery",
        "mandatoryInFullE2e": true,
        "zeroCmiRequiresCoverageProof": true,
        "reuse": [
          "specialist hunters",
          "Exa infrastructure",
          "full-e2e supervisor / research-to-page workflow",
          "classifyCompetitiveMarketIntelligence",
          "competitive-future-cycle-presentation-v1"
        ]
      }
    },
    {
      "id": "4b",
      "name": "Commercial-actionability gate (discovery qualification)",
      "mandatory": true,
      "commandHint": "classifyCommercialActionability against effective research date; expired one-time events must not enter active Hotel Market",
      "contract": "gdi-commercial-actionability-gate-v1"
    },
    {
      "id": 5,
      "name": "Commercial qualification / research review",
      "commandHint": "quality gates + commercial-actionability reassessment inside research-to-page workflow",
      "actionabilityGate": "gdi-commercial-actionability-gate-v1"
    },
    {
      "id": 6,
      "name": "Airtable persistence",
      "commandHint": "canonical upsert + presentation persistence contract"
    },
    {
      "id": 7,
      "name": "Quality review / customer-visible eligibility",
      "commandHint": "test:gdi-full-customer-consistency-audit-v1 / field authority / assertCustomerInventoryPassesActionabilityGate",
      "actionabilityGate": "gdi-commercial-actionability-gate-v1"
    },
    {
      "id": 8,
      "name": "Founder preview",
      "commandHint": "authenticated GDI publicationPackage=1 (Mode B ≡ share)"
    },
    {
      "id": 9,
      "name": "Package staging",
      "commandHint": "immutable fingerprinted candidate; enforceCommercialActionabilityGate on staged inventory",
      "actionabilityGate": "gdi-commercial-actionability-gate-v1"
    },
    {
      "id": 10,
      "name": "Founder approval / publication certification",
      "commandHint": "approve exact contentFingerprintSha256 after actionability certification",
      "actionabilityGate": "gdi-commercial-actionability-gate-v1"
    },
    {
      "id": 11,
      "name": "Production publication",
      "commandHint": "Dealality production release (GDI)"
    },
    {
      "id": 12,
      "name": "Production parity",
      "commandHint": "browser parity vs founder preview"
    },
    {
      "id": 13,
      "name": "Weekly refresh and feedback",
      "commandHint": "weekly-refresh + feedback store; re-run actionability gate vs refresh date; stage removals/future-cycle reassessment",
      "actionabilityGate": "gdi-commercial-actionability-gate-v1"
    }
  ],
  "entrypoint": "npm run gdi:full-e2e -- --hotel <hotelId> --authorization-ref <ref> --dry-run",
  "paidAndPublishRequireSeparateFounderAuth": true
}
