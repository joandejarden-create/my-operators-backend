{
  "schema": "gdi-hotel-configuration-schema-v1",
  "requiredKeys": [
    "hotelId",
    "displayName"
  ],
  "optionalKeys": [
    "brand",
    "operator",
    "country",
    "city",
    "aliases",
    "commercialPriorities",
    "demandTerritory",
    "competitiveContext",
    "capabilityProfile",
    "locale",
    "geo",
    "adpFixturePath"
  ],
  "configRoot": "config/group-demand-intelligence/hotels/{hotelId}.json",
  "unknownValuesRemainUnknown": true,
  "needPeriodsMustNotBeFabricated": true,
  "noHardcodedFrontendRoutesRequired": true,
  "authAppUsesQueryHotelOrPilotFallback": true,
  "authAppFallbackNote": "Auth app falls back to the template reference hotel when hotelId query is absent; rendering remains hotel-independent via hotelId.",
  "exampleHotels": [
    {
