      "role": "REFERENCE_PUBLISHED",
      "expectPkg": true,
      "configPresent": true,
      "displayName": "Bethesda Marriott",
      "publicationPackagePresent": true,
      "expectPkgMatch": true,
      "bethesdaDataLeak": false,
      "sharedCurrentPointer": false
    },
    {
      "hotelId": "recnPB3Q02NO8Ma1o",
      "role": "EXISTING_UNPUBLISHED_US",
      "expectPkg": false,
      "configPresent": true,
      "displayName": "Wyndham San Diego Bayside",
      "publicationPackagePresent": false,
      "expectPkgMatch": true,
      "bethesdaDataLeak": false,
      "sharedCurrentPointer": false
    },
    {
      "hotelId": "recKRJjcPnb4tVDDS",
      "role": "INTERNATIONAL",
      "expectPkg": false,
      "configPresent": true,
      "displayName": "Spice Island Beach Resort",
      "publicationPackagePresent": false,
      "expectPkgMatch": true,
      "bethesdaDataLeak": false,
      "sharedCurrentPointer": false
    },
    {
      "hotelId": "recG66DQJKP2c0UNh",
      "role": "NO_PUBLISHED_PACKAGE",
      "expectPkg": false,
      "configPresent": true,
      "displayName": "Renaissance New York Times Square Hotel",
      "publicationPackagePresent": false,
      "expectPkgMatch": true,
      "bethesdaDataLeak": false,
      "sharedCurrentPointer": false
    }
  ]
}
