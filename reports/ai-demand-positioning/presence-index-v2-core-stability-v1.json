{
  "title": "ADP_AI_PRESENCE_INDEX_V2_AND_CORE_BENCHMARK_STABILITY_COMPLETE",
  "presenceIndexV2Contract": {
    "CUSTOMER_QUESTION": "How often does this hotel appear in comparable AI responses for this demand territory, relative to the average appearance rate of governed CORE comparable hotels in the same territory and provider scope?",
    "FORMULA": "PRESENCE_INDEX_V2 = SUBJECT_PRESENCE_RATE / CORE_BENCHMARK_PRESENCE_RATE × 100; CORE_BENCHMARK = arithmetic mean of all territory CORE peer rates (zeros included); no cap",
    "CORE_ONLY": "YES",
    "ZERO_PRESENCE_CORE_PEERS_INCLUDED": "YES",
    "SECONDARY_IN_DENOMINATOR": 0,
    "SCORE_CAP": "NONE",
    "MIN_CORE_PEERS_RECOMMENDED": 4,
    "ALL_PROVIDERS_METHOD": "A_EQUAL_MEAN_OF_PROVIDER_RATES_THEN_INDEX",
    "GRAIN": "property × demand territory × provider × period; All Providers derived",
    "NOT": [
      "fair-share consideration",
      "market share",
      "booking demand",
      "recommendation share"
    ]
  },
